#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    rm -f /usr/bin/orchard /usr/share/applications/orchard.desktop /usr/share/icons/hicolor/scalable/apps/orchard.svg /usr/share/mime/packages/orchard.xml /usr/share/icons/hicolor/scalable/mimetypes/application-x-orchard-project.svg
    update-mime-database /usr/share/mime 2>/dev/null || true
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor 2>/dev/null || true
fi
exit 0
