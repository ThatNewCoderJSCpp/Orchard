<!grove max-fps=120 idle-fps=5>
<grove>
    <head>
        <title>Orchard</title>
        <style src="orchard.bark"></style>
        <script lang="walnut" src="orchard.wal"></script>
    </head>
    <body id="app" title="Orchard" app-id="orchard">
        <page id="welcome" current>
            <center>
                <column class="welcome">
                    <div class="logo">&#127823; Orchard</div>
                    <div class="muted">A light, fast 2D and 3D game engine</div>
                    <column class="card">
                        <div class="card-title">NEW PROJECT</div>
                        <row class="kv">
                            <text class="k">Name</text>
                            <input_string id="new-name" class="v" value="My Game" />
                        </row>
                        <row class="kv">
                            <text class="k">Kind</text>
                            <input_select id="new-dim" value="3d">
                                <option value="3d">3D</option>
                                <option value="2d">2D</option>
                            </input_select>
                        </row>
                        <row class="kv">
                            <text class="k">Location</text>
                            <input_file id="new-where" mode="folder" placeholder="Pick a folder">Choose...</input_file>
                        </row>
                        <row class="actions">
                            <button id="create" class="primary">Create project</button>
                        </row>
                    </column>
                    <column class="card">
                        <div class="card-title">OPEN</div>
                        <input_file id="open-folder" mode="folder" hide-value>Open project folder...</input_file>
                    </column>
                    <div id="welcome-error" class="error hidden"></div>
                </column>
            </center>
        </page>

        <page id="editor">
            <row class="appbar">
                <text class="brand">&#127823; Orchard</text>
                <text id="project-name" class="project"></text>
                <text id="dirty" class="dirty hidden">&#9679;</text>
                <button id="save" class="ghost">Save</button>
                <div class="sep"></div>
                <button id="view-2d" class="seg">2D</button>
                <button id="view-3d" class="seg">3D</button>
                <button id="reset-cam" class="ghost">Reset view</button>
                <input_select id="render-mode" value="medium" class="add-kind" title="Lighting quality. Low to Ultra run at game speed (Ultra is like Voxelspire's Ultra). Ray traced is real path tracing kept fast and clean with a denoiser, for moving around and playing. Path traced and Photons go further and keep refining while the view is still.">
                    <option value="low">Lighting: Low</option>
                    <option value="medium">Lighting: Medium</option>
                    <option value="high">Lighting: High</option>
                    <option value="ultra">Lighting: Ultra</option>
                    <option value="rt">Ray traced (GPU, real time)</option>
                    <option value="path">Path traced (GPU)</option>
                    <option value="photon">Photons (GPU)</option>
                </input_select>
                <text id="trace-info" class="muted hidden"></text>
                <button id="axes-open" class="ghost axes-open" title="Pick which way is up, flip axes and see what it looks like">Axes: y-up</button>
                <button id="physics-open" class="ghost" title="How friction and bounce mix when two colliders touch">Physics</button>
                <div class="grow"></div>
                <text id="mode" class="mode muted"></text>
                <button id="play" class="primary">&#9654; Play</button>
                <button id="stop" class="danger hidden">&#9632; Stop</button>
                <text id="version" class="muted version"></text>
            </row>

            <row class="workspace">
                <column id="outliner" class="side left outliner">
                    <row class="side-head">
                        <div class="card-title grow">THIS SCENE</div>
                        <button id="outline-options" class="small ghost" title="Outliner options">&#8943;</button>
                        <button id="outline-side" class="small ghost" title="Move the outliner to the other side">&#8644;</button>
                    </row>
                    <row class="side-head">
                        <input_select id="outline-group" value="sections" class="grow" title="How to sort what's in the scene">
                            <option value="sections">Sections</option>
                            <option value="hierarchy">Scene tree</option>
                            <option value="flat">A to Z</option>
                        </input_select>
                        <input_string id="outline-filter" class="grow filter" placeholder="Filter" />
                    </row>
                    <column id="outline-settings" class="outline-settings hidden">
                        <row class="kv">
                            <text class="k">Order</text>
                            <input_select id="outline-sort" value="scene" class="v">
                                <option value="scene">Scene order</option>
                                <option value="name">By name</option>
                            </input_select>
                        </row>
                        <row class="kv">
                            <button id="outline-open-all" class="small ghost grow" title="Show what's inside everything">Expand all</button>
                            <button id="outline-close-all" class="small ghost grow" title="Fold everything up">Collapse all</button>
                        </row>
                        <input_bool id="outline-empty" switch>Show empty sections</input_bool>
                        <input_bool id="preview-effects" switch>Preview light effects while editing</input_bool>
                        <input_bool id="details-open" switch checked>Show details</input_bool>
                        <input_bool id="view-cull" switch checked>Hide what the camera can't see</input_bool>
                        <input_bool id="view-shadows" switch checked>Shadows (real near, soft blobs far)</input_bool>
                        <input_bool id="view-lights" switch checked>Show the scene's lights in the editor view</input_bool>
                        <input_bool id="view-materials" switch checked>Show materials (colors, glass, mirrors)</input_bool>
                        <input_bool id="view-particles" switch checked>Show particles</input_bool>
                    </column>
                    <row class="side-head">
                        <input_select id="add-kind" value="box" class="grow">
                            <option value="">Empty</option>
                            <option value="box">Physics box</option>
                            <option value="ball">Physics ball</option>
                            <option value="ground">Ground</option>
                            <option value="trigger">Trigger zone</option>
                            <option value="light">Light</option>
                            <option value="water">Water</option>
                            <option value="pool">Pool (walls and water)</option>
                            <option value="hemisphere">Hemisphere</option>
                            <option value="human:basic">Character (one capsule)</option>
                            <option value="human:head-and-body">Character (head and body)</option>
                            <option value="human:full-body">Character (head, torso, arms, legs)</option>
                            <option value="human:detailed">Character (limbs, bones, organs)</option>
                            <option value="terrain:hills">Terrain (hills)</option>
                            <option value="terrain:mountains">Terrain (mountains)</option>
                            <option value="terrain:flat">Terrain (flat, for sculpting)</option>
                            <option value="terrain:forest">Forest (terrain with trees)</option>
                            <option value="sparks">Sparks</option>
                            <option value="smoke">Smoke</option>
                            <option value="fire">Fire</option>
                        </input_select>
                        <button id="add-entity" class="small">+ Add</button>
                    </row>
                    <column id="tree" class="scroll tree" tabindex="0"></column>
                    <row class="side-head project-head">
                        <button id="project-fold" class="small ghost fold" title="Show or hide the project's files">&#9662;</button>
                        <div class="card-title grow">PROJECT</div>
                        <input_file id="import-files" class="small" filter="Models and images: *.glb *.gltf *.obj *.fbx *.png *.jpg *.jpeg *.tga *.webp; Models: *.glb *.gltf *.obj *.fbx; All files: *" multiple hide-value title="Copy models (glTF/GLB from Blender, OBJ) and images into the project's Assets folder. Blender: File &gt; Export &gt; glTF 2.0 (.glb)">Import...</input_file>
                    </row>
                    <column id="files" class="scroll files project-files" title="Click a script or graph to open it, a model to place it. Right-click for more."></column>
                </column>

                <column class="center">
                    <row id="template-bar" class="template-bar hidden">
                        <text class="template-icon">&#9670;</text>
                        <text id="template-name" class="template-name">Editing an entity template</text>
                        <text class="muted grow">Every copy in the scene updates when you save. Play tests it on its own.</text>
                        <button id="template-discard" class="small ghost">Discard changes</button>
                        <button id="template-done" class="small primary">Save and go back</button>
                    </row>
                    <row id="center-tabs" class="center-tabs hidden">
                        <button id="tab-scene" class="ctab on">&#9635; Scene</button>
                        <button id="tab-script" class="ctab hidden">Script</button>
                        <button id="tab-script-close" class="ctab-x hidden" title="Close the script">&#215;</button>
                        <button id="tab-graph" class="ctab hidden">Graph</button>
                        <button id="tab-graph-close" class="ctab-x hidden" title="Close the graph">&#215;</button>
                    </row>
                    <column id="script-view" class="script-view hidden">
                        <row class="viewbar">
                            <text id="script-name" class="script-name">Script</text>
                            <text id="script-state" class="muted"></text>
                            <div class="grow"></div>
                            <text class="muted">Open with</text>
                            <input_string id="editor-command" class="editor-command" placeholder="code, kate, gedit..." />
                            <button id="script-external" class="small ghost" title="Open this file in the editor named on the left (put {file} anywhere in the command to place the file name)">Open in my editor</button>
                            <button id="script-reload" class="small ghost">Reload</button>
                            <button id="script-save" class="small primary">Save</button>
                        </row>
                        <input_code id="script-editor" language="walnut" class="script-editor"></input_code>
                    </column>
                    <column id="graph-view" class="script-view hidden">
                        <row class="viewbar">
                            <button id="graph-save" class="small primary" title="Write the graph to its file (Ctrl+S)">Save</button>
                            <button id="graph-add" class="small" title="Add a node in the middle of the view (or right-click empty space)">+ Add node</button>
                            <button id="graph-frame" class="small ghost" title="Fit every node in the view (F)">Frame all</button>
                            <button id="graph-undo" class="small ghost" title="Ctrl+Z">Undo</button>
                            <button id="graph-redo" class="small ghost" title="Ctrl+Y">Redo</button>
                            <button id="graph-walnut" class="small ghost" title="Show the Walnut this graph turns into">Show Walnut</button>
                            <row id="graph-edit" class="graph-edit hidden">
                                <text id="graph-edit-label" class="hint"></text>
                                <input_string id="graph-edit-value" />
                                <button id="graph-edit-ok" class="small primary">Set</button>
                                <button id="graph-edit-cancel" class="small ghost">Cancel</button>
                            </row>
                            <div class="grow"></div>
                            <text id="graph-status" class="hint"></text>
                        </row>
                        <gpu_canvas id="graph-canvas" tabindex="0"></gpu_canvas>
                        <text class="hint overlay">Drag a header: move &#183; Drag from a pin: connect &#183; Click a value: edit &#183; Right-click: add &amp; options &#183; Right / middle drag: pan &#183; Wheel: zoom &#183; Del, Ctrl+D, Ctrl+Z, F</text>
                    </column>
                    <row class="viewbar" id="scene-bar">
                        <button id="tool-select" class="seg tool on" title="Click something to select it and see its details. Drag empty space to orbit.">&#10148; Select</button>
                        <button id="tool-move" class="seg tool" title="Drag something to slide it along the ground. Drag one of its arrows to move along that axis. Shift-drag moves it up and down. (G)">&#10021; Move</button>
                        <button id="tool-rotate" class="seg tool" title="Drag one of the rings to turn the selection around that axis. Hold Shift to snap to 15 degrees. (R)">&#10227; Rotate</button>
                        <button id="tool-scale" class="seg tool" title="Drag a handle to stretch along that axis, or drag the middle to resize evenly. (T)">&#9635; Scale</button>
                        <button id="tool-orbit" class="seg tool" title="Drag anywhere to orbit around the view's center">&#8635; Orbit</button>
                        <button id="tool-pan" class="seg tool" title="Drag anywhere to slide the view">&#9995; Pan</button>
                        <button id="tool-sculpt" class="seg tool" title="Paint hills and valleys on a terrain. Drag on the ground. (B)">&#9968; Sculpt</button>
                        <div class="grow"></div>
                        <text class="hint" title="W A S D or arrows: move · Q / E: down / up · Shift: faster">WASD: fly</text>
                    </row>
                    <row id="sculpt-bar" class="viewbar sculpt-bar hidden">
                        <input_select id="brush-kind" value="raise" class="add-kind" title="What the brush does">
                            <option value="raise">Raise</option>
                            <option value="lower">Lower</option>
                            <option value="smooth">Smooth</option>
                            <option value="flatten">Flatten</option>
                            <option value="noise">Roughen</option>
                            <option value="set-height">Set height</option>
                        </input_select>
                        <text class="hint">Size</text>
                        <input_float id="brush-radius" value="8" step="1" title="Brush radius (m)" />
                        <text class="hint">Strength</text>
                        <input_float id="brush-strength" value="0.5" step="0.1" title="Raise/lower: metres per dab. Smooth/flatten: 0 to 1" />
                        <text class="hint">Softness</text>
                        <input_float id="brush-falloff" value="0.5" step="0.1" title="0 = hard edge, 1 = soft all the way" />
                        <text class="hint">Height</text>
                        <input_float id="brush-height" value="0" step="0.5" title="Set-height target (m). Flatten uses the height you start on." />
                    </row>
                    <gpu_canvas id="viewport" tabindex="0"></gpu_canvas>
                    <text id="scene-hint" class="hint overlay">Click: select &#183; Right-click: options &#183; Drag: orbit &#183; Right drag: pan &#183; Wheel: zoom &#183; Keys go to scripts while playing</text>
                </column>

                <column class="side right">
                    <column class="inspector-panel">
                        <div class="card-title">INSPECTOR</div>
                        <column id="inspector" class="scroll inspector hidden">
                            <input_string id="ins-name" />
                            <div class="sub-title">Position</div>
                            <row class="xyz">
                                <input_float id="px" step="0.1" /><input_float id="py" step="0.1" /><input_float id="pz" step="0.1" />
                            </row>
                            <div class="sub-title">Rotation</div>
                            <row class="xyz">
                                <input_float id="rx" step="1" /><input_float id="ry" step="1" /><input_float id="rz" step="1" />
                            </row>
                            <div class="sub-title">Scale</div>
                            <row class="xyz">
                                <input_float id="sx" step="0.1" /><input_float id="sy" step="0.1" /><input_float id="sz" step="0.1" />
                            </row>
                            <div class="sub-title">Script</div>
                            <input_select id="ins-script" value="" placeholder="No script">
                                <option value="">No script</option>
                            </input_select>
                            <input_select id="new-script" value="" placeholder="New script...">
                                <option value="">New script...</option>
                                <option value=".wal">Walnut</option>
                                <option value=".cpp">C++</option>
                                <option value=".c">C</option>
                                <option value=".cs">C#</option>
                                <option value=".java">Java</option>
                                <option value=".lua">Lua</option>
                            </input_select>
                            <hr />
                            <div class="section-title">PHYSICS</div>
                            <text id="ins-owner" class="muted hidden"></text>
                            <row class="kv">
                                <text class="k">Body</text>
                                <input_bool id="ins-body" />
                            </row>
                            <column id="body-box" class="body-box hidden">
                                <row class="kv">
                                    <text class="k">Type</text>
                                    <input_select id="ins-body-type" value="dynamic">
                                        <option value="dynamic">Dynamic</option>
                                        <option value="static">Static</option>
                                        <option value="kinematic">Kinematic</option>
                                    </input_select>
                                </row>
                                <row class="kv">
                                    <text class="k">Enabled</text>
                                    <input_bool id="ins-body-enabled" />
                                </row>
                                <column id="body-nums" class="nums"></column>
                                <column id="flags" class="flags"></column>
                                <row class="side-head">
                                    <div class="sub-title grow">All fizmo flags</div>
                                    <button id="aflags-toggle" class="small ghost">Show</button>
                                </row>
                                <column id="aflags" class="flags hidden"></column>
                            </column>
                            <row class="side-head">
                                <div class="sub-title grow">Colliders</div>
                                <input_select id="collider-kind" value="box" class="add-kind">
                                    <option value="box">Box</option>
                                    <option value="sphere">Sphere</option>
                                    <option value="capsule">Capsule</option>
                                    <option value="cylinder">Cylinder</option>
                                    <option value="cone">Cone</option>
                                    <option value="rounded-box">Rounded box</option>
                                    <option value="hemisphere">Hemisphere / dome / bowl</option>
                                </input_select>
                                <button id="add-collider" class="small">+ Collider</button>
                            </row>
                            <column id="colliders" class="colliders"></column>
                            <row class="actions">
                                <button id="add-child" class="ghost">Add child</button>
                                <button id="delete-entity" class="danger">Delete</button>
                            </row>
                        </column>
                        <text id="inspector-empty" class="muted">Select something in the scene.</text>
                    </column>
                    <column id="details-box" class="details-box">
                        <row class="side-head">
                            <div class="card-title grow">DETAILS</div>
                            <button id="details-edit" class="small ghost" title="Edit everything about it">Edit&#8230;</button>
                        </row>
                        <column id="details" class="scroll details"></column>
                    </column>
                </column>
            </row>

            <column class="bottom">
                <row class="tabs">
                    <button class="tab" to="entities-page">Entities</button>
                    <button class="tab" to="code-page">Script</button>
                    <button class="tab" to="console-page">Console</button>
                    <div id="code-title" class="muted code-title">Pick a script or graph under Project on the left. Graphs show the Walnut they turn into.</div>
                </row>
                <page id="entities-page">
                    <column class="entities-page">
                        <row class="entities-head">
                            <input_string id="template-new-name" class="grow" placeholder="Name for a new entity" />
                            <button id="template-new" class="small">+ New entity</button>
                            <button id="template-from" class="small ghost" title="Turn the selected entity and its children into a reusable entity">From selected</button>
                        </row>
                        <div class="muted entities-help">Build an entity once (colliders, materials, textures, particles, scripts), then drop copies into the scene. Scripts are shared files, so many entities can use the same one. Scripts can spawn them with instantiate("Name", x, y, z).</div>
                        <column id="templates" class="scroll files"></column>
                    </column>
                </page>
                <page id="code-page">
                    <input_code id="code" language="walnut" class="code" readonly></input_code>
                </page>
                <page id="console-page" current>
                    <column id="console" class="scroll console"></column>
                </page>
            </column>
        </page>
        <modal id="inspect-dialog" class="inspect-modal">
            <column class="inspect-dialog">
                <row class="axes-head">
                    <text class="section-title">PROPERTIES</text>
                    <text id="inspect-title" class="axes-name"></text>
                    <div class="grow"></div>
                    <text class="muted">Changes apply right away</text>
                </row>
                <column id="inspect-body" class="scroll inspect-body"></column>
                <row class="axes-actions">
                    <button id="inspect-delete" class="danger">Delete</button>
                    <div class="grow"></div>
                    <button to="close" class="primary">Done</button>
                </row>
            </column>
        </modal>

        <modal id="physics-dialog" class="physics-modal">
            <column class="physics-dialog">
                <text class="section-title">PHYSICS</text>
                <text class="sub-title">World</text>
                <column id="world-fields" class="world-fields nums"></column>
                <text class="sub-title">Mixing</text>
                <div class="muted">When two colliders touch, their friction and bounce are mixed into one value. These are the project's defaults; each collider can pick its own in the inspector. When two colliders pick different mixes, the one further down the list wins, the same rule Unity, Unreal and PhysX use.</div>
                <row class="kv">
                    <text class="k">Friction mix</text>
                    <input_select id="friction-mix" class="v" value="geometric-mean"></input_select>
                </row>
                <row class="kv">
                    <text class="k">Bounce mix</text>
                    <input_select id="bounce-mix" class="v" value="maximum"></input_select>
                </row>
                <column id="mix-help" class="mix-help"></column>
                <row class="axes-actions">
                    <div class="grow"></div>
                    <button to="close" class="primary">Done</button>
                </row>
            </column>
        </modal>

        <modal id="axes-dialog" class="axes-modal">
            <column class="axes-dialog">
                <row class="axes-head">
                    <text class="section-title">AXES</text>
                    <text id="axes-name" class="axes-name"></text>
                    <div class="grow"></div>
                    <text id="axes-hint" class="muted">Drag the preview to look around, double-click to reset</text>
                </row>
                <row class="axes-body">
                    <column class="axes-side">
                        <div class="sub-title">START FROM</div>
                        <column id="axes-styles-3d" class="axes-styles">
                            <column id="ax-y-up" class="axes-style" tabindex="0"><div class="axes-style-name">Y up</div><div class="axes-style-like">Godot, OpenGL, Maya, Fizmo</div></column>
                            <column id="ax-y-up-left" class="axes-style" tabindex="0"><div class="axes-style-name">Y up, left-handed</div><div class="axes-style-like">Unity, DirectX</div></column>
                            <column id="ax-z-up" class="axes-style" tabindex="0"><div class="axes-style-name">Z up</div><div class="axes-style-like">Blender, 3ds Max</div></column>
                            <column id="ax-z-up-left" class="axes-style" tabindex="0"><div class="axes-style-name">Z up, left-handed</div><div class="axes-style-like">Unreal</div></column>
                            <column id="ax-source" class="axes-style" tabindex="0"><div class="axes-style-name">Z up, X forward</div><div class="axes-style-like">Source</div></column>
                        </column>
                        <column id="axes-styles-2d" class="axes-styles hidden">
                            <column id="ax-2d-up" class="axes-style" tabindex="0"><div class="axes-style-name">Y up</div><div class="axes-style-like">math, Box2D, Unity 2D</div></column>
                            <column id="ax-2d-down" class="axes-style" tabindex="0"><div class="axes-style-name">Y down</div><div class="axes-style-like">screens, Godot 2D, GameMaker</div></column>
                        </column>
                        <div class="sub-title">FLIP</div>
                        <row class="axes-flips">
                            <button id="ax-flip-x" class="seg axes-flip">X</button>
                            <button id="ax-flip-y" class="seg axes-flip">Y</button>
                            <button id="ax-flip-z" class="seg axes-flip">Z</button>
                            <div class="grow"></div>
                            <button id="ax-standard" class="ghost small">Standard</button>
                        </row>
                        <column id="axes-facts" class="axes-facts"></column>
                    </column>
                    <gpu_canvas id="axes-preview" class="axes-preview"></gpu_canvas>
                </row>
                <row class="axes-actions">
                    <input_bool id="axes-keep" class="axes-keep" switch checked>Keep my scenes looking the same (convert positions and rotations)</input_bool>
                    <div class="grow"></div>
                    <button to="close" class="ghost">Cancel</button>
                    <button id="axes-apply" class="primary">Apply</button>
                </row>
            </column>
        </modal>
    </body>
</grove>
