});

grove::Element: viewport = grove::get_by_id("viewport");

viewport.on("canvas_resize", [](grove::Event&: e) -> void {
    call("viewport_resize", e.x().to_string() + "\t" + e.y().to_string());
});

viewport.on("mouse_down", [](grove::Event&: e) -> void {
    grove::get_by_id("viewport").focus();
    if (grove::get_by_id("tool-sculpt").has_class("on") && e.button() == 1l && mode == "edit") then {
        if (sculpt_at(e.x(), e.y(), "begin")) then {
            sculpt_down = true;
            return;
        }
    }
    string: shift = "0";
    if (e.shift()) then {
        shift = "1";
    }
    call("viewport_press", e.x().to_string() + "\t" + e.y().to_string() + "\t" + e.button().to_string() + "\t" + shift);
});

viewport.on("mouse_move", [](grove::Event&: e) -> void {
    if (grove::get_by_id("tool-sculpt").has_class("on") && mode == "edit") then {
        if (sculpt_down) then {
            sculpt_at(e.x(), e.y(), "drag");
            return;
        }
        sculpt_at(e.x(), e.y(), "hover");
    }
    call("viewport_move", e.x().to_string() + "\t" + e.y().to_string());
});

viewport.on("mouse_up", [](grove::Event&: e) -> void {
    if (sculpt_down) then {
        sculpt_down = false;
        call("terrain_sculpt", sculpt_id + "\t0\t0\t0\t\t\t\t\t\tend");
        refresh();
        return;
    }
    string: r = call("viewport_release", e.x().to_string() + "\t" + e.y().to_string());
    if (r.starts_with("pick")) then {
        select(reason(r));
    } else if (r.starts_with("moved")) then {
        select(reason(r));
        refresh();
    } else if (r.starts_with("menu")) then {
        string: id = "";
        auto: f = r.split("\t");
        if (f.size() > 1l) then {
            id = f[1];
        }
        if (!id.empty()) then {
            select(id);
        }
        open_context_menu("viewport", id, e.x(), e.y());
    }
});

viewport.on("wheel", [](grove::Event&: e) -> void {
    e.prevent_default();
    call("viewport_zoom", e.delta_y().to_string());
});

viewport.on("key_down", [](grove::Event&: e) -> void {
    if (mode == "playing") then {
        e.prevent_default();
        call("key", e.key() + "\t1");
    } else if (fly_key(e, true)) then {
        e.prevent_default();
    } else then {
        edit_key(e);
    }
});

viewport.on("blur", [](grove::Event&: e) -> void {
    call("fly_key", "*\t0");
});

grove::get_by_id("tree").on("key_down", [](grove::Event&: e) -> void {
    edit_key(e);
});

viewport.on("key_up", [](grove::Event&: e) -> void {
    if (mode == "playing") then {
        call("key", e.key() + "\t0");
    } else then {
        fly_key(e, false);
    }
});

grove::get_by_id("tool-sculpt").on("click", [](grove::Event&: e) -> void { set_tool("sculpt"); });
grove::get_by_id("brush-kind").on("change", [](grove::Event&: e) -> void { send_brush(); });
grove::get_by_id("brush-radius").on("change", [](grove::Event&: e) -> void { send_brush(); });
grove::get_by_id("brush-strength").on("change", [](grove::Event&: e) -> void { send_brush(); });
grove::get_by_id("brush-falloff").on("change", [](grove::Event&: e) -> void { send_brush(); });
grove::get_by_id("brush-height").on("change", [](grove::Event&: e) -> void { send_brush(); });

grove::get_by_id("tool-select").on("click", [](grove::Event&: e) -> void { set_tool("select"); });
grove::get_by_id("tool-move").on("click", [](grove::Event&: e) -> void { set_tool("move"); });
grove::get_by_id("tool-orbit").on("click", [](grove::Event&: e) -> void { set_tool("orbit"); });
grove::get_by_id("tool-rotate").on("click", [](grove::Event&: e) -> void { set_tool("rotate"); });
grove::get_by_id("tool-scale").on("click", [](grove::Event&: e) -> void { set_tool("scale"); });
grove::get_by_id("tool-pan").on("click", [](grove::Event&: e) -> void { set_tool("pan"); });

grove::get_by_id("app").on("key_down", [](grove::Event&: e) -> void {
    if (e.ctrl() && (e.key() == "S" || e.key() == "s")) then {
        e.prevent_default();
        if (center == "script") then {
            save_script();
        } else if (center == "graph") then {
            save_graph();
        } else then {
            save_project();
        }
    }
    if (e.ctrl() && (e.key() == "D" || e.key() == "d") && !selected.empty() && mode == "edit" && center == "scene") then {
        e.prevent_default();
        menu_target = selected;
        handle_menu("duplicate");
    }
});

grove::set_interval(200.0, []() -> void {
    poll_logs();
    if (grove::get_by_id("render-mode").value_string() != "off") then {
        auto: t = call("trace_status", "").split("\t");
        if (t.size() > 2l) then {
            if (!t[2].empty()) then {
                grove::get_by_id("trace-info").set_inner_text(t[2]);
            } else then {
                grove::get_by_id("trace-info").set_inner_text(t[1] + " samples");
            }
        }
    }
    if (mode != "edit") then {
        string: before = mode;
        refresh();
        if (mode == "playing") then {
            fill_transform();
            if (details_on && !selected.empty()) then {
                fill_details();
            }
        }
        if (before == "building" && mode == "playing") then {
            build_tree();
        }
    }
});

grove::get_by_id("tree").on("menu", [](grove::Event&: e) -> void {
    handle_menu(e.key());
});

grove::get_by_id("viewport").on("menu", [](grove::Event&: e) -> void {
