grove::get_by_id("import-files").on("change", [](grove::Event&: e) -> void {
    string: picked = e.target().value_string();
    if (picked.empty()) then {
        return;
    }
    string: r = call("import_files", picked);
    if (failed(r)) then {
        say(reason(r), true);
        return;
    }
    auto: f = r.split("\t");
    build_files();
    if (f.size() > 2l) then {
        say("Imported " + f[1] + " file(s) into Assets. Click a model in Files to place it.", false);
    }
});

