grove::get_by_id("sy").on("change", [](grove::Event&: e) -> void { set_field("sy"); });
grove::get_by_id("sy").on("input", [](grove::Event&: e) -> void {
    if (e.has_edit_text() && number_text(e.edit_text())) then {
        live_number("transform", "sy", e.edit_text());
    }
});
grove::get_by_id("sz").on("change", [](grove::Event&: e) -> void { set_field("sz"); });
grove::get_by_id("sz").on("input", [](grove::Event&: e) -> void {
