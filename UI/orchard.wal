grove::Element: graph_canvas = grove::get_by_id("graph-canvas");

graph_canvas.on("canvas_resize", [](grove::Event&: e) -> void {
    if (!graph_path.empty() && center == "graph") then {
        call("graph_show", graph_path);
    }
});

graph_canvas.on("mouse_down", [](grove::Event&: e) -> void {
    grove::get_by_id("graph-canvas").focus();
    string: shift = "0";
    if (e.shift()) then {
        shift = "1";
    }
    string: ctrl = "0";
    if (e.ctrl() || e.meta()) then {
        ctrl = "1";
    }
    if (e.button() == 2l) then {
        e.prevent_default();
    }
    call("graph_press", e.x().to_string() + "\t" + e.y().to_string() + "\t" + e.button().to_string() + "\t" + shift + "\t" + ctrl);
});

graph_canvas.on("mouse_move", [](grove::Event&: e) -> void {
    call("graph_move", e.x().to_string() + "\t" + e.y().to_string());
});

graph_canvas.on("mouse_up", [](grove::Event&: e) -> void {
    graph_result(call("graph_release", e.x().to_string() + "\t" + e.y().to_string()));
});

graph_canvas.on("wheel", [](grove::Event&: e) -> void {
    e.prevent_default();
    call("graph_wheel", e.x().to_string() + "\t" + e.y().to_string() + "\t" + e.delta_y().to_string());
});

graph_canvas.on("key_down", [](grove::Event&: e) -> void {
    string: ctrl = "0";
    if (e.ctrl() || e.meta()) then {
        ctrl = "1";
    }
    string: shift = "0";
    if (e.shift()) then {
        shift = "1";
    }
    if (ctrl == "1" && (e.key() == "S" || e.key() == "s")) then {
        e.prevent_default();
        e.stop_propagation();
        save_graph();
    } else then {
        string: r = call("graph_key", e.key() + "\t" + ctrl + "\t" + shift);
        if (!r.empty()) then {
            e.prevent_default();
            e.stop_propagation();
            graph_status();
        }
    }
});

