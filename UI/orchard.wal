function set_tool(const string&: tool) -> void {
    string: now = call("set_tool", tool);
    grove::get_by_id("tool-select").remove_class("on");
    grove::get_by_id("tool-move").remove_class("on");
    grove::get_by_id("tool-orbit").remove_class("on");
    grove::get_by_id("tool-rotate").remove_class("on");
    grove::get_by_id("tool-scale").remove_class("on");
    grove::get_by_id("tool-pan").remove_class("on");
    grove::get_by_id("tool-sculpt").remove_class("on");
    grove::get_by_id("tool-" + now).add_class("on");
    show("sculpt-bar", now == "sculpt");
    if (now == "sculpt") then {
        send_brush();
    }
} end function set_tool

function send_brush() -> void {
    call("terrain_brush", grove::get_by_id("brush-kind").value_string() + "\t" + grove::get_by_id("brush-radius").value_float().to_string() + "\t" + grove::get_by_id("brush-strength").value_float().to_string() + "\t" + grove::get_by_id("brush-falloff").value_float().to_string() + "\t" + grove::get_by_id("brush-height").value_float().to_string());
} end function send_brush

function sculpt_at(short float: x, short float: y, const string&: phase) -> bool {
    string: hit = call("terrain_pick", x.to_string() + "\t" + y.to_string());
    if (hit.empty()) then {
        return false;
    }
    auto: f = hit.split("\t");
    if (phase == "hover") then {
        return true;
    }
    if (phase == "begin") then {
        sculpt_id = f[0];
    }
    string: target = "";
    if (grove::get_by_id("brush-kind").value_string() == "set-height") then {
        target = grove::get_by_id("brush-height").value_float().to_string();
    }
    call("terrain_sculpt", sculpt_id + "\t" + f[1] + "\t" + f[2] + "\t" + f[3] + "\t\t\t\t\t" + target + "\t" + phase);
    return true;
} end function sculpt_at

function fly_key(grove::Event&: e, bool: pressed) -> bool {
    string: k = e.key();
    bool: fly = k == "W" || k == "A" || k == "S" || k == "D" || k == "Q" || k == "E";
    fly = fly || k == "w" || k == "a" || k == "s" || k == "d" || k == "q" || k == "e";
    fly = fly || k == "UpArrow" || k == "DownArrow" || k == "LeftArrow" || k == "RightArrow";
    fly = fly || k == "Up" || k == "Down" || k == "Left" || k == "Right";
    fly = fly || k == "ArrowUp" || k == "ArrowDown" || k == "ArrowLeft" || k == "ArrowRight";
    bool: shift = k == "Shift" || k == "LeftShift" || k == "RightShift" || k == "ShiftLeft" || k == "ShiftRight";
    if (!fly && !shift) then {
        return false;
    }
    if (e.ctrl() || e.alt() || e.meta()) then {
        return false;
    }
    string: v = "0";
    if (pressed) then {
        v = "1";
    }
    call("fly_key", k + "\t" + v);
    if (!shift) then {
        string: s = "0";
        if (e.shift()) then {
            s = "1";
        }
        call("fly_key", "Shift\t" + s);
    }
    return fly;
} end function fly_key

function call(const string&: name, const string&: arg) -> string {
    return grove::call("orchard." + name, arg);
} end function call

function el(const string&: tag, const string&: cls, const string&: label) -> grove::Element {
    grove::Element: e = grove::create_element(tag);
    if (!cls.empty()) then {
        e.set_attribute("class", cls);
    }
    if (!label.empty()) then {
        e.set_inner_text(label);
    }
    return e;
} end function el

function clear(grove::Element&: e) -> void {
    while (e.child_count() > 0l) {
        e.child(0l).remove();
    }
} end function clear

function show(const string&: id, bool: on) -> void {
    grove::Element: e = grove::get_by_id(id);
    if (on) then {
        e.remove_class("hidden");
    } else then {
        e.add_class("hidden");
    }
} end function show

function failed(const string&: result) -> bool {
    return result.starts_with("error");
} end function failed

function reason(const string&: result) -> string {
    auto: f = result.split("\t");
    if (f.size() > 1l) then {
        return f[1];
    }
    return result;
} end function reason

function say(const string&: msg, bool: bad) -> void {
    grove::Element: box = grove::get_by_id("console");
    grove::Element: line = el("div", "log-line", msg);
    if (bad) then {
        line.add_class("bad");
    }
    box.append_child(line);
    line.set_attribute("reveal", "1");
} end function say

function mark_flip(const string&: id, bool: on) -> void {
    if (on) then {
        grove::get_by_id(id).add_class("on");
    } else then {
        grove::get_by_id(id).remove_class("on");
    }
} end function mark_flip

function flip_axis(const string&: axis) -> void {
    string: r = call("flip_axis", axis);
    if (failed(r)) then {
        say(reason(r), true);
    }
    refresh();
} end function flip_axis

string: axes_dim = "3d";
string: axes_style = "y-up";
string: axes_flips = "";

function show_axes(const string&: fields) -> void {
    auto: f = fields.split("\t");
    if (f.size() < 5l) then {
        return;
    }
    axes_dim = f[0];
    axes_style = f[1];
    axes_flips = f[2];
    grove::get_by_id("axes-name").set_inner_text(f[3]);
    show("axes-styles-3d", axes_dim == "3d");
    show("axes-styles-2d", axes_dim == "2d");
    show("ax-flip-y", axes_dim == "3d");
    show("ax-flip-z", axes_dim == "3d");
    show("axes-hint", axes_dim == "3d");
    mark_flip("ax-y-up", f[4] == "y-up");
    mark_flip("ax-y-up-left", f[4] == "y-up-left");
    mark_flip("ax-z-up", f[4] == "z-up");
    mark_flip("ax-z-up-left", f[4] == "z-up-left");
    mark_flip("ax-source", f[4] == "source");
    mark_flip("ax-2d-up", axes_style == "up");
    mark_flip("ax-2d-down", axes_style == "down");
    mark_flip("ax-flip-x", axes_flips.contains("x"));
    mark_flip("ax-flip-y", axes_flips.contains("y"));
    mark_flip("ax-flip-z", axes_flips.contains("z"));
    grove::Element: facts = grove::get_by_id("axes-facts");
    clear(facts);
    for (long int: i = 5l; i < f.size(); i += 1l) {
        facts.append_child(el("div", "axes-fact", f[i]));
    }
} end function show_axes

function pick_axes(const string&: style, const string&: flips) -> void {
    string: r = call("axes_pending", style + "\t" + flips);
    if (failed(r)) then {
        say(reason(r), true);
        return;
    }
    show_axes(r);
} end function pick_axes

function flip_letter(const string&: axis, const string&: flipped) -> string {
    bool: on = axes_flips.contains(axis);
    if (axis == flipped) then {
        on = !on;
    }
    if (on) then {
        return axis;
    }
    return "";
} end function flip_letter

function toggle_axes_flip(const string&: axis) -> void {
    pick_axes(axes_style, flip_letter("x", axis) + flip_letter("y", axis) + flip_letter("z", axis));
} end function toggle_axes_flip

function refresh() -> void {
    auto: f = call("state", "").split("\t");
    if (f.size() < 10l) then {
        return;
    }
    grove::get_by_id("project-name").set_inner_text(f[1]);
    show("dirty", f[6] == "1");
    grove::get_by_id("version").set_inner_text("v" + f[8]);
    if (f.size() > 11l) then {
        string: label = f[10];
        if (f[2] == "2d") then {
            label = "y-" + f[10];
        }
        if (f[11].contains("x")) then {
            label = label + " flip-x";
        }
        if (f[2] == "3d" && f[11].contains("y")) then {
            label = label + " flip-y";
        }
        if (f[11].contains("z")) then {
            label = label + " flip-z";
        }
        grove::get_by_id("axes-open").set_inner_text("Axes: " + label);
    }
    if (f[7] == "2d") then {
        grove::get_by_id("view-2d").add_class("on");
        grove::get_by_id("view-3d").remove_class("on");
    } else then {
        grove::get_by_id("view-3d").add_class("on");
        grove::get_by_id("view-2d").remove_class("on");
    }
    selected = f[5];
    mode = f[9];
    grove::Element: m = grove::get_by_id("mode");
    m.remove_class("playing");
    m.remove_class("building");
    if (mode == "playing") then {
        m.set_inner_text("Playing");
        m.add_class("playing");
    } else if (mode == "building") then {
        m.set_inner_text("Building scripts...");
        m.add_class("building");
    } else then {
        m.set_inner_text("");
    }
    show("play", mode == "edit");
    show("stop", mode != "edit");
    update_template_bar();
} end function refresh

function build_tree() -> void {
    build_outliner();
} end function build_tree

function section_row(const string&: line) -> grove::Element {
    auto: f = line.split("\t");
    string: key = f[1];
    string: arrow = "\u25BE";
    if (f[4] == "1") then {
        arrow = "\u25B8";
    }
    grove::Element: row = el("row", "outline-section", "");
    row.append_child(el("text", "", arrow));
    row.append_child(el("text", "grow", f[2]));
    row.append_child(el("text", "outline-count", f[3]));
    row.on("click", [key](grove::Event&: e) -> void {
        call("toggle_section", key);
        build_outliner();
    });
    return row;
} end function section_row

function outliner_row(const string&: line) -> grove::Element {
    auto: f = line.split("\t");
    string: id = f[1];
    long int: depth = std::io::parse_int<long int>(f[2]);
    grove::Element: row = el("row", "node", "");
    row.add_class("cat-" + f[6]);
    row.set_style("padding", "4px 8px 4px " + (4l + depth * 14l).to_string() + "px");
    string: fold = "";
    if (f.size() > 8l) then {
        fold = f[7];
    }
    if (fold.empty()) then {
        row.append_child(el("text", "node-fold", ""));
    } else then {
        string: arrow = "\u25B8";
        if (fold == "open") then {
            arrow = "\u25BE";
        }
        grove::Element: twist = el("text", "node-fold twist", arrow);
        twist.set_attribute("title", "Show or hide what's inside (" + f[8] + ")");
        twist.on("mouse_down", [id](grove::Event&: e) -> void {
            e.prevent_default();
            e.stop_propagation();
            auto: r = call("toggle_fold", id).split("\t");
            if (r.size() > 1l && r[0] == "closed" && !r[1].empty() && r[1] != selected) then {
                select(r[1]);
            } else then {
                build_outliner();
            }
        });
        row.append_child(twist);
    }
    row.append_child(el("text", "node-icon", f[4]));
    row.append_child(el("text", "node-name", f[3]));
    if (!f[5].empty()) then {
        row.append_child(el("text", "tag", f[5]));
    }
    if (fold == "closed") then {
        row.append_child(el("text", "node-count", f[8]));
    }
    row.set_attribute("entity", id);
    if (id == selected) then {
        row.add_class("selected");
    }
    row.on("click", [id](grove::Event&: e) -> void {
        select(id);
    });
    row.on("double_click", [id](grove::Event&: e) -> void {
        open_inspect(id, false);
    });
    row.on("mouse_down", [id](grove::Event&: e) -> void {
        if (e.button() == 2l) then {
            e.prevent_default();
            e.stop_propagation();
            open_context_menu("tree", id, e.x(), e.y());
        }
    });
    return row;
} end function outliner_row

function part_row(const string&: line) -> grove::Element {
    auto: f = line.split("\t");
    string: id = f[1];
    long int: depth = std::io::parse_int<long int>(f[2]);
    grove::Element: row = el("row", "node part", "");
    row.add_class("part-" + f[6]);
    row.set_style("padding", "3px 8px 3px " + (4l + depth * 14l).to_string() + "px");
    row.append_child(el("text", "node-fold", ""));
    row.append_child(el("text", "node-icon", f[4]));
    row.append_child(el("text", "node-name", f[3]));
    if (!f[5].empty()) then {
        row.append_child(el("text", "tag", f[5]));
    }
    row.set_attribute("entity", id);
    row.on("click", [id](grove::Event&: e) -> void {
        if (id != selected) then {
            select(id);
        }
    });
    row.on("double_click", [id](grove::Event&: e) -> void {
        open_inspect(id, false);
    });
    row.on("mouse_down", [id](grove::Event&: e) -> void {
        if (e.button() == 2l) then {
            e.prevent_default();
            e.stop_propagation();
            open_context_menu("tree", id, e.x(), e.y());
        }
    });
    return row;
} end function part_row

function build_outliner() -> void {
    grove::Element: box = grove::get_by_id("tree");
    clear(box);
    string: filter = grove::get_by_id("outline-filter").value_string();
    auto: rows = call("outline", outline_group + "\t" + filter).split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() >= 5l && f[0] == "section") then {
            box.append_child(section_row(rows[i]));
        } else if (f.size() >= 7l && f[0] == "item") then {
            box.append_child(outliner_row(rows[i]));
        } else if (f.size() >= 7l && f[0] == "part") then {
            box.append_child(part_row(rows[i]));
        }
    }
} end function build_outliner

function fill_details() -> void {
    grove::Element: box = grove::get_by_id("details");
    clear(box);
    show("details-box", details_on);
    if (!details_on) then {
        return;
    }
    if (selected.empty()) then {
        box.append_child(el("text", "muted", "Click something to see its details. Right-click it for more."));
        show("details-edit", false);
        return;
    }
    show("details-edit", true);
    auto: rows = call("details", selected).split("\n");
    bool: first = true;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        if (f[0] == "head") then {
            if (first) then {
                box.append_child(el("text", "detail-title", f[1]));
                first = false;
            } else then {
                box.append_child(el("text", "detail-head", f[1]));
            }
            continue;
        }
        if (f.size() < 3l) then {
            continue;
        }
        grove::Element: row = el("row", "detail-row", "");
        row.append_child(el("text", "detail-k", f[1]));
        if (f[0] == "kv") then {
            row.append_child(el("text", "detail-v", f[2]));
        } else if (f[0] == "yes") then {
            if (f[2] == "1") then {
                row.append_child(el("text", "detail-v detail-yes", "Yes"));
            } else then {
                row.append_child(el("text", "detail-v detail-no", "No"));
            }
        } else if (f[0] == "swatch") then {
            grove::Element: chip = el("div", "swatch", "");
            chip.set_style("background", f[2]);
            row.append_child(chip);
            string: label = f[2];
            if (f.size() > 3l && !f[3].empty()) then {
                label = f[3];
            }
            row.append_child(el("text", "detail-v", label));
        }
        box.append_child(row);
    }
} end function fill_details

function inspect_set(const string&: key, const string&: value) -> void {
    if (filling || inspecting.empty()) then {
        return;
    }
    string: r = call("inspect_set", inspecting + "\t" + key + "\t" + value);
    if (r.empty()) then {
        say("Couldn't change " + key, true);
        return;
    }
    if (r == "template") then {
        inspecting = "";
        grove::get_by_id("inspect-dialog").close_modal();
        after_scene_swap();
        return;
    }
    if (r == "rebuild") then {
        fill_inspect();
    }
    if (key == "name") then {
        grove::get_by_id("inspect-title").set_inner_text(value);
    }
    refresh();
    build_outliner();
    fill_details();
    if (inspecting == selected) then {
        fill_inspector();
    }
} end function inspect_set

function inspect_field(const string&: line) -> grove::Element {
    auto: f = line.split("\t");
    string: key = f[1];
    string: kind = f[3];
    string: value = f[4];
    string: extra = "";
    if (f.size() > 5l) then {
        extra = f[5];
    }
    grove::Element: wrap = el("column", "", "");
    grove::Element: row = el("row", "inspect-row", "");
    if (kind == "button") then {
        grove::Element: b = el("button", "small ghost", f[2]);
        b.on("click", [key, value](grove::Event&: e) -> void {
            inspect_set(key, value);
        });
        row.append_child(b);
        wrap.append_child(row);
        return wrap;
    }
    row.append_child(el("text", "inspect-k", f[2]));
    if (kind == "string") then {
        grove::Element: input = grove::create_element("input_string");
        input.set_attribute("class", "inspect-v");
        input.set_value_string(value);
        input.on("change", [key](grove::Event&: e) -> void {
            inspect_set(key, e.target().value_string());
        });
        if (key == "name") then {
            input.set_attribute("id", "inspect-name");
        }
        row.append_child(input);
    } else if (kind == "float") then {
        grove::Element: input = grove::create_element("input_float");
        input.set_attribute("class", "inspect-v");
        if (!extra.empty()) then {
            input.set_attribute("step", extra);
        }
        input.set_value_float(std::io::parse_float<short float>(value));
        input.on("change", [key](grove::Event&: e) -> void {
            inspect_set(key, e.target().value_float().to_string());
        });
        input.on("input", [key](grove::Event&: e) -> void {
            if (e.has_edit_text() && number_text(e.edit_text())) then {
                live_number("inspect", key, e.edit_text());
            }
        });
        row.append_child(input);
    } else if (kind == "slider") then {
        string: step = "0.01";
        string: lo = "0";
        string: hi = "1";
        if (!extra.empty()) then {
            auto: parts = extra.split("|");
            step = parts[0];
            if (parts.size() > 2l) then {
                lo = parts[1];
                hi = parts[2];
            }
        }
        grove::Element: pair = number_row("inspect", key, "", value, lo, hi, step, "slider");
        pair.set_attribute("class", "num-row inspect-v");
        row.append_child(pair);
    } else if (kind == "bool") then {
        grove::Element: input = grove::create_element("input_bool");
        input.set_attribute("switch", "");
        input.set_value_bool(value == "1");
        input.on("change", [key](grove::Event&: e) -> void {
            string: v = "0";
            if (e.target().value_bool()) then {
                v = "1";
            }
            inspect_set(key, v);
        });
        row.append_child(input);
    } else if (kind == "color") then {
        grove::Element: input = grove::create_element("input_color");
        input.set_attribute("class", "inspect-v");
        input.set_value_color(value);
        input.on("change", [key](grove::Event&: e) -> void {
            inspect_set(key, e.target().value_color());
        });
        row.append_child(input);
    } else if (kind == "select") then {
        grove::Element: pick = grove::create_element("input_select");
        pick.set_attribute("class", "inspect-v");
        auto: opts = extra.split("|");
        for (long int: i = 0l; i < opts.size(); i += 1l) {
            auto: kv = opts[i].split("=");
            if (kv.size() < 2l) then {
                continue;
            }
            grove::Element: opt = el("option", "", kv[1]);
            opt.set_attribute("value", kv[0]);
            pick.append_child(opt);
        }
        pick.set_value_string(value);
        pick.on("change", [key](grove::Event&: e) -> void {
            inspect_set(key, e.target().value_string());
        });
        row.append_child(pick);
    } else if (kind == "vec3") then {
        auto: parts = value.split(",");
        grove::Element: xyz = el("row", "xyz inspect-v", "");
        for (long int: i = 0l; i < 3l; i += 1l) {
            grove::Element: input = grove::create_element("input_float");
            if (!extra.empty()) then {
                input.set_attribute("step", extra);
            }
            input.set_attribute("axis", i.to_string());
            if (i < parts.size()) then {
                input.set_value_float(std::io::parse_float<short float>(parts[i]));
            }
            input.on("change", [key](grove::Event&: e) -> void {
                grove::Element: box = e.target().parent();
                string: v = box.child(0l).value_float().to_string() + "," + box.child(1l).value_float().to_string() + "," + box.child(2l).value_float().to_string();
                inspect_set(key, v);
            });
            xyz.append_child(input);
        }
        row.append_child(xyz);
    } else then {
        row.append_child(el("text", "inspect-v", value));
    }
    wrap.append_child(row);
    if (f.size() > 6l && !f[6].empty()) then {
        wrap.append_child(el("text", "inspect-help", f[6]));
    }
    return wrap;
} end function inspect_field

function fill_inspect() -> void {
    grove::Element: body = grove::get_by_id("inspect-body");
    clear(body);
    if (inspecting.empty()) then {
        return;
    }
    filling = true;
    auto: rows = call("inspect", inspecting).split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        if (f[0] == "title") then {
            grove::get_by_id("inspect-title").set_inner_text(f[1]);
        } else if (f[0] == "group") then {
            body.append_child(el("text", "inspect-group", f[1]));
        } else if (f[0] == "field" && f.size() >= 5l) then {
            body.append_child(inspect_field(rows[i]));
        }
    }
    filling = false;
} end function fill_inspect

function open_inspect(const string&: id, bool: rename) -> void {
    if (id.empty()) then {
        return;
    }
    inspecting = id;
    if (id != selected) then {
        select(id);
    }
    fill_inspect();
    grove::get_by_id("inspect-dialog").open_modal();
    if (rename) then {
        grove::get_by_id("inspect-name").focus();
    }
} end function open_inspect

function open_context_menu(const string&: owner, const string&: id, short float: x, short float: y) -> void {
    string: r = call("context_menu", owner + "\t" + id + "\t" + x.to_string() + "\t" + y.to_string());
    if (r.empty()) then {
        return;
    }
    menu_target = id;
    if (r != "none" && r != selected) then {
        selected = r;
        build_outliner();
        fill_inspector();
        fill_details();
    }
} end function open_context_menu

function handle_menu(const string&: key) -> void {
    string: r = call("menu_action", menu_target + "\t" + key);
    auto: f = r.split("\t");
    refresh();
    if (f[0] == "inspect" && f.size() > 1l) then {
        open_inspect(f[1], false);
        return;
    }
    if (f[0] == "tool" && f.size() > 2l) then {
        set_tool(f[1]);
        select(f[2]);
        grove::get_by_id("viewport").focus();
        return;
    }
    if (f[0] == "rename" && f.size() > 1l) then {
        open_inspect(f[1], true);
        return;
    }
    if (f[0] == "details" && f.size() > 1l) then {
        details_on = true;
        grove::get_by_id("details-open").set_value_bool(true);
        call("set_pref", "details.open\t1");
        select(f[1]);
        return;
    }
    if (f[0] == "select" && f.size() > 1l) then {
        select(f[1]);
        return;
    }
    if (f[0] == "template") then {
        after_scene_swap();
        if (f.size() > 1l && !f[1].empty()) then {
            select(f[1]);
        }
        return;
    }
    if (f[0] == "templates") then {
        build_templates();
        build_files();
        grove::navigate("entities-page");
        say("Made an entity from it. Find it in the Entities tab.", false);
    }
    if (f[0] == "error" && f.size() > 1l) then {
        say(f[1], true);
    }
    build_outliner();
    fill_inspector();
    fill_details();
} end function handle_menu

function edit_key(grove::Event&: e) -> void {
    if (selected.empty() || mode != "edit") then {
        return;
    }
    string: k = e.key();
    if (k == "Enter") then {
        e.prevent_default();
        open_inspect(selected, false);
    } else if (k == "F2") then {
        e.prevent_default();
        open_inspect(selected, true);
    } else if (k == "F" || k == "f") then {
        e.prevent_default();
        menu_target = selected;
        handle_menu("focus");
    } else if (k == "Delete") then {
        e.prevent_default();
        menu_target = selected;
        handle_menu("delete");
    } else if (k == "G" || k == "g") then {
        e.prevent_default();
        set_tool("move");
    } else if (k == "R" || k == "r") then {
        e.prevent_default();
        set_tool("rotate");
    } else if (k == "T" || k == "t") then {
        e.prevent_default();
        set_tool("scale");
    } else if (k == "B" || k == "b") then {
        e.prevent_default();
        set_tool("sculpt");
    } else if (k == "Escape") then {
        e.prevent_default();
        set_tool("select");
    }
} end function edit_key

function place_outliner(const string&: side) -> void {
    grove::Element: panel = grove::get_by_id("outliner");
    grove::Element: space = panel.parent();
    outline_side = side;
    if (side == "right") then {
        panel.remove();
        space.append_child(panel);
        panel.remove_class("left");
        panel.add_class("on-right");
    } else then {
        panel.remove();
        space.insert_before(panel, space.child(0l));
        panel.add_class("left");
        panel.remove_class("on-right");
    }
} end function place_outliner

function apply_outliner_prefs() -> void {
    auto: f = call("outliner_prefs", "").split("\t");
    if (f.size() < 7l) then {
        return;
    }
    filling = true;
    outline_group = f[1];
    grove::get_by_id("outline-group").set_value_string(f[1]);
    grove::get_by_id("outline-sort").set_value_string(f[2]);
    grove::get_by_id("outline-empty").set_value_bool(f[3] == "1");
    grove::get_by_id("preview-effects").set_value_bool(f[5] == "1");
    details_on = f[6] != "0";
    grove::get_by_id("details-open").set_value_bool(details_on);
    if (f.size() > 9l) then {
        grove::get_by_id("view-cull").set_value_bool(f[8] != "0");
        grove::get_by_id("view-shadows").set_value_bool(f[9] != "0");
    }
    if (f.size() > 11l) then {
        grove::get_by_id("view-lights").set_value_bool(f[10] != "0");
        grove::get_by_id("view-materials").set_value_bool(f[11] != "0");
    }
    if (f.size() > 12l) then {
        grove::get_by_id("view-particles").set_value_bool(f[12] != "0");
    }
    if (f.size() > 7l) then {
        string: mode = f[7];
        if (mode == "off") then {
            mode = "medium";
            if (f.size() > 13l) then {
                mode = f[13];
            }
        }
        grove::get_by_id("render-mode").set_value_string(mode);
        show("trace-info", f[7] != "off");
    }
    filling = false;
    if (f[0] != outline_side) then {
        place_outliner(f[0]);
    }
} end function apply_outliner_prefs

function after_scene_swap() -> void {
    refresh();
    build_outliner();
    fill_details();
    fill_inspector();
    build_templates();
    build_files();
    update_template_bar();
} end function after_scene_swap

function update_template_bar() -> void {
    auto: f = call("template_state", "").split("\t");
    bool: editing = f.size() > 1l && !f[0].empty();
    show("template-bar", editing);
    if (editing) then {
        string: label = "Editing entity: " + f[1];
        if (f.size() > 2l && f[2] == "1") then {
            label = label + " (not saved)";
        }
        grove::get_by_id("template-name").set_inner_text(label);
    }
} end function update_template_bar

function template_action(const string&: action, const string&: path) -> void {
    string: r = call(action, path);
    if (failed(r)) then {
        say(reason(r), true);
        return;
    }
    auto: f = r.split("\t");
    if (action == "edit_template") then {
        after_scene_swap();
        if (f.size() > 1l && !f[1].empty()) then {
            select(f[1]);
        }
        say("Editing " + path + ". Save and go back when you're done.", false);
        return;
    }
    if (action == "place_template") then {
        refresh();
        build_outliner();
        if (f.size() > 1l) then {
            select(f[1]);
        }
        build_templates();
        return;
    }
    if (action == "duplicate_template" && f.size() > 1l) then {
        say("Made " + f[1], false);
    }
    if (action == "delete_template") then {
        say("Deleted " + path, false);
        after_scene_swap();
        return;
    }
    build_templates();
    build_files();
} end function template_action

function build_templates() -> void {
    grove::Element: box = grove::get_by_id("templates");
    clear(box);
    auto: rows = call("templates", "").split("\n");
    long int: shown = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 5l) then {
            continue;
        }
        string: path = f[0];
        string: cls = "template-row";
        if (f[4] == "1") then {
            cls = "template-row editing";
        }
        grove::Element: row = el("row", cls, "");
        row.append_child(el("text", "cat-instance", "\u25C6"));
        row.append_child(el("text", "template-title", f[1]));
        string: count = f[3] + " \u00B7 " + f[2] + " in the scene";
        row.append_child(el("text", "template-count grow", count));
        grove::Element: edit = el("button", "small", "Edit");
        edit.on("click", [path](grove::Event&: e) -> void {
            template_action("edit_template", path);
        });
        row.append_child(edit);
        grove::Element: place = el("button", "small primary", "Place");
        place.set_attribute("title", "Drop a copy where the view is looking");
        place.on("click", [path](grove::Event&: e) -> void {
            template_action("place_template", path);
        });
        row.append_child(place);
        grove::Element: copy = el("button", "small ghost", "Copy");
        copy.on("click", [path](grove::Event&: e) -> void {
            template_action("duplicate_template", path);
        });
        row.append_child(copy);
        grove::Element: gone = el("button", "small ghost danger", "Delete");
        gone.on("click", [path](grove::Event&: e) -> void {
            template_action("delete_template", path);
        });
        row.append_child(gone);
        box.append_child(row);
        shown += 1l;
    }
    if (shown == 0l) then {
        box.append_child(el("text", "muted", "No entities yet. Make one with + New entity, or select something in the scene and press From selected."));
    }
} end function build_templates

function build_files() -> void {
    grove::Element: box = grove::get_by_id("files");
    clear(box);
    auto: rows = call("files", "").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        string: path = f[1];
        grove::Element: row = el("row", "file", "");
        row.append_child(el("text", "kind", f[0]));
        row.append_child(el("text", "", path));
        string: kind = f[0];
        row.on("click", [path, kind](grove::Event&: e) -> void {
            if (kind == "script") then {
                open_script(path);
            } else if (kind == "graph") then {
                open_graph(path);
            } else if (kind == "model") then {
                file_target = path;
                file_action("place");
            } else then {
                open_file(path);
            }
        });
        row.on("mouse_down", [path](grove::Event&: e) -> void {
            if (e.button() == 2l) then {
                e.prevent_default();
                e.stop_propagation();
                file_target = path;
                call("file_menu", path + "\t" + e.x().to_string() + "\t" + e.y().to_string());
            }
        });
        box.append_child(row);
    }
} end function build_files

function fill_transform() -> void {
    auto: f = call("transform", selected).split("\t");
    if (selected.empty() || f.size() < 10l) then {
        return;
    }
    filling = true;
    if (!grove::get_by_id("ins-name").focused()) then {
        grove::get_by_id("ins-name").set_value_string(f[0]);
    }
    auto: ids = "px py pz rx ry rz sx sy sz".split(" ");
    for (long int: i = 0l; i < ids.size(); i += 1l) {
        grove::Element: input = grove::get_by_id(ids[i]);
        if (!input.focused()) then {
            input.set_attribute("value", f[i + 1l]);
        }
    }
    filling = false;
} end function fill_transform

function fill_inspector() -> void {
    auto: f = call("transform", selected).split("\t");
    bool: has = !selected.empty() && f.size() >= 10l;
    show("inspector", has);
    show("inspector-empty", !has);
    if (!has) then {
        return;
    }
    fill_transform();
    fill_components();
} end function fill_inspector

function number_text(const string&: entry) -> bool {
    if (entry.empty()) then {
        return false;
    }
    bool: digit = false;
    for (long int: i = 0l; i < entry.size(); i += 1l) {
        string: c = entry.substr(i, 1l);
        if (c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9") then {
            digit = true;
        } else if (c != "." && c != "-" && c != "+" && c != "e" && c != "E") then {
            return false;
        }
    }
    if (!digit) then {
        return false;
    }
    string: last = entry.substr(entry.size() - 1l, 1l);
    return last != "." && last != "-" && last != "+" && last != "e" && last != "E";
} end function number_text

function live_number(const string&: target, const string&: field, const string&: value) -> void {
    if (filling) then {
        return;
    }
    if (target == "world") then {
        call("set_world_setting", field + "\t" + value);
    } else if (target == "inspect") then {
        if (!inspecting.empty()) then {
            call("inspect_set", inspecting + "\t" + field + "\t" + value);
        }
    } else if (target == "transform") then {
        if (!selected.empty()) then {
            call("set_transform", selected + "\t" + field + "\t" + value);
        }
    } else if (!selected.empty()) then {
        call("set_component", selected + "\t" + field + "\t" + value);
    }
} end function live_number

function commit_number(const string&: target, const string&: field, const string&: value) -> void {
    if (target == "world") then {
        string: r = call("set_world_setting", field + "\t" + value);
        if (failed(r)) then {
            say(reason(r), true);
        }
    } else if (target == "inspect") then {
        inspect_set(field, value);
    } else then {
        set_component(field, value);
    }
} end function commit_number

function number_row(const string&: target, const string&: field, const string&: label, const string&: value, const string&: lo, const string&: hi, const string&: step, const string&: kind) -> grove::Element {
    grove::Element: row = el("row", "num-row", "");
    row.append_child(el("text", "num-k", label));
    bool: whole = kind == "int" || kind == "int-slider";
    bool: sliding = kind == "slider" || kind == "int-slider";
    if (sliding) then {
        grove::Element: slider = grove::create_element("input_slider");
        slider.set_attribute("class", "num-slider");
        slider.set_attribute("readout", "false");
        slider.set_attribute("min", lo);
        slider.set_attribute("max", hi);
        slider.set_attribute("step", step);
        slider.set_value_float(std::io::parse_float<short float>(value));
        slider.on("change", [target, field, whole](grove::Event&: e) -> void {
            grove::Element: box = e.target().parent().child(2l);
            string: v = "";
            if (whole) then {
                box.set_value_integer(std::io::parse_int<long int>(e.target().get_attribute("value")));
                v = box.value_integer().to_string();
            } else then {
                box.set_value_float(e.target().value_float());
                v = box.value_float().to_string();
            }
            commit_number(target, field, v);
        });
        slider.on("input", [target, field, whole](grove::Event&: e) -> void {
            grove::Element: box = e.target().parent().child(2l);
            string: v = "";
            if (whole) then {
                box.set_value_integer(std::io::parse_int<long int>(e.target().get_attribute("value")));
                v = box.value_integer().to_string();
            } else then {
                box.set_value_float(e.target().value_float());
                v = box.value_float().to_string();
            }
            live_number(target, field, v);
        });
        row.append_child(slider);
    }
    string: tag = "input_float";
    if (whole) then {
        tag = "input_integer";
    }
    grove::Element: box = grove::create_element(tag);
    if (sliding) then {
        box.set_attribute("class", "num-box");
    } else then {
        box.set_attribute("class", "num-box-wide");
    }
    box.set_attribute("min", lo);
    box.set_attribute("max", hi);
    if (whole) then {
        box.set_value_integer(std::io::parse_int<long int>(value));
    } else then {
        box.set_attribute("step", step);
        box.set_value_float(std::io::parse_float<short float>(value));
    }
    box.on("change", [target, field, whole, sliding](grove::Event&: e) -> void {
        string: v = "";
        if (whole) then {
            v = e.target().value_integer().to_string();
        } else then {
            v = e.target().value_float().to_string();
        }
        if (sliding) then {
            e.target().parent().child(1l).set_value_float(std::io::parse_float<short float>(v));
        }
        commit_number(target, field, v);
    });
    box.on("input", [target, field, sliding](grove::Event&: e) -> void {
        if (!e.has_edit_text() || !number_text(e.edit_text())) then {
            return;
        }
        string: v = e.edit_text();
        if (sliding) then {
            e.target().parent().child(1l).set_value_float(std::io::parse_float<short float>(v));
        }
        live_number(target, field, v);
    });
    box.on("invalid", [label, lo, hi](grove::Event&: e) -> void {
        string: what = label;
        if (what.empty()) then {
            what = "That box";
        }
        say(what + ": \"" + e.input_text() + "\" isn't a number. Use " + lo + " to " + hi + ".", true);
    });
    row.append_child(box);
    return row;
} end function number_row

function pick_row(const string&: target, const string&: field, const string&: label, const string&: value, const string&: options) -> grove::Element {
    grove::Element: row = el("row", "num-row", "");
    row.append_child(el("text", "num-k", label));
    grove::Element: pick = grove::create_element("input_select");
    pick.set_attribute("class", "num-slider");
    auto: opts = options.split("|");
    for (long int: i = 0l; i < opts.size(); i += 1l) {
        auto: kv = opts[i].split("=");
        if (kv.size() < 2l) then {
            continue;
        }
        grove::Element: opt = el("option", "", kv[1]);
        opt.set_attribute("value", kv[0]);
        pick.append_child(opt);
    }
    pick.set_value_string(value);
    pick.on("change", [target, field](grove::Event&: e) -> void {
        commit_number(target, field, e.target().value_string());
    });
    row.append_child(pick);
    return row;
} end function pick_row

function bool_row(const string&: target, const string&: field, const string&: label, bool: on) -> grove::Element {
    grove::Element: row = el("row", "flag", "");
    row.append_child(el("div", "", label));
    grove::Element: sw = grove::create_element("input_bool");
    sw.set_value_bool(on);
    sw.on("change", [target, field](grove::Event&: e) -> void {
        string: v = "0";
        if (e.target().value_bool()) then {
            v = "1";
        }
        commit_number(target, field, v);
    });
    row.append_child(sw);
    return row;
} end function bool_row

function fill_world_fields() -> void {
    grove::Element: box = grove::get_by_id("world-fields");
    clear(box);
    string: r = call("physics_fields", "");
    if (failed(r)) then {
        return;
    }
    auto: rows = r.split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f[0] == "num" && f.size() >= 8l) then {
            box.append_child(number_row("world", f[1], f[2], f[3], f[4], f[5], f[6], f[7]));
        } else if (f[0] == "bool" && f.size() >= 4l) then {
            box.append_child(bool_row("world", f[1], f[2], f[3] == "1"));
        } else if (f[0] == "pick" && f.size() >= 5l) then {
            box.append_child(pick_row("world", f[1], f[2], f[3], f[4]));
        }
    }
} end function fill_world_fields

function float_input(const string&: value, const string&: step, const string&: field) -> grove::Element {
    grove::Element: input = grove::create_element("input_float");
    input.set_attribute("step", step);
    input.set_value_float(std::io::parse_float<short float>(value));
    input.on("change", [field](grove::Event&: e) -> void {
        set_component(field, e.target().value_float().to_string());
    });
    input.on("input", [field](grove::Event&: e) -> void {
        if (e.has_edit_text() && number_text(e.edit_text())) then {
            live_number("component", field, e.edit_text());
        }
    });
    return input;
} end function float_input

function switch_row(const string&: label, bool: on, const string&: field) -> grove::Element {
    grove::Element: row = el("row", "flag", "");
    row.append_child(el("div", "", label));
    grove::Element: sw = grove::create_element("input_bool");
    sw.set_value_bool(on);
    sw.on("change", [field](grove::Event&: e) -> void {
        string: v = "0";
        if (e.target().value_bool()) then {
            v = "1";
        }
        set_component(field, v);
    });
    row.append_child(sw);
    return row;
} end function switch_row

function lock_button(const string&: label, const string&: tip, bool: on, const string&: field) -> grove::Element {
    grove::Element: b = el("button", "seg lock", label);
    b.set_attribute("title", tip);
    if (on) then {
        b.add_class("on");
    }
    b.on("click", [field, on](grove::Event&: e) -> void {
        string: v = "1";
        if (on) then {
            v = "0";
        }
        set_component(field, v);
        fill_components();
    });
    return b;
} end function lock_button

function vec_row(const string&: field, const string&: label, const string&: x, const string&: y, const string&: z, const string&: step) -> grove::Element {
    grove::Element: box = el("column", "vec-row", "");
    box.append_child(el("div", "sub-title", label));
    grove::Element: row = el("row", "xyz", "");
    row.append_child(float_input(x, step, field + "x"));
    row.append_child(float_input(y, step, field + "y"));
    row.append_child(float_input(z, step, field + "z"));
    box.append_child(row);
    return box;
} end function vec_row

function collider_card(const string&: line) -> grove::Element {
    auto: f = line.split("\t");
    string: index = f[1];
    string: base = "collider:" + index + ":";
    grove::Element: card = el("column", "collider", "");
    grove::Element: head = el("row", "collider-head", "");
    grove::Element: shape = grove::create_element("input_select");
    string: shape_list = "box sphere capsule";
    if (f.size() > 24l) then {
        shape_list = f[24];
    }
    auto: shapes = shape_list.split(" ");
    for (long int: i = 0l; i < shapes.size(); i += 1l) {
        grove::Element: opt = el("option", "", shapes[i]);
        opt.set_attribute("value", shapes[i]);
        shape.append_child(opt);
    }
    shape.set_value_string(f[2]);
    shape.on("change", [base](grove::Event&: e) -> void {
        set_component(base + "shape", e.target().value_string());
        fill_components();
    });
    head.append_child(shape);
    if (f.size() > 34l) then {
        grove::Element: cname = grove::create_element("input_string");
        cname.set_attribute("class", "grow");
        cname.set_attribute("placeholder", "Name (optional)");
        cname.set_value_string(f[33]);
        cname.on("change", [base](grove::Event&: e) -> void {
            set_component(base + "name", e.target().value_string());
            build_tree();
        });
        head.append_child(cname);
    } else then {
        head.append_child(el("div", "grow", ""));
    }
    grove::Element: remove = el("button", "small danger", "Remove");
    remove.on("click", [index](grove::Event&: e) -> void {
        set_component("remove_collider", index);
        fill_components();
        build_tree();
    });
    head.append_child(remove);
    card.append_child(head);
    if (f.size() > 30l && (f[2] == "mesh" || f[2] == "convex-hull")) then {
        card.append_child(el("div", "sub-title", "Model file (size scales it)"));
        grove::Element: src = grove::create_element("input_select");
        auto: models = call("files", "").split("\n");
        grove::Element: none = el("option", "", "Pick a model");
        none.set_attribute("value", "");
        src.append_child(none);
        for (long int: m = 0l; m < models.size(); m += 1l) {
            auto: mf = models[m].split("\t");
            if (mf.size() < 2l || mf[0] != "model") then {
                continue;
            }
            grove::Element: opt = el("option", "", mf[1]);
            opt.set_attribute("value", mf[1]);
            src.append_child(opt);
        }
        src.set_value_string(f[30]);
        src.on("change", [base](grove::Event&: e) -> void {
            set_component(base + "source", e.target().value_string());
            fill_components();
        });
        card.append_child(src);
    }
    bool: has_mass = f.size() > 34l;
    string: locks = "";
    if (has_mass) then {
        locks = f[32];
    }
    if (has_mass) then {
        grove::Element: size_head = el("row", "lock-head", "");
        size_head.append_child(el("div", "sub-title grow", "Size"));
        size_head.append_child(el("text", "lock-label", "Lock"));
        size_head.append_child(lock_button("X", "Keep size X when mass or density changes", locks.contains("x"), base + "lock_sx"));
        size_head.append_child(lock_button("Y", "Keep size Y when mass or density changes", locks.contains("y"), base + "lock_sy"));
        if (f[24].contains("cylinder")) then {
            size_head.append_child(lock_button("Z", "Keep size Z when mass or density changes", locks.contains("z"), base + "lock_sz"));
        }
        card.append_child(size_head);
    } else then {
        card.append_child(el("div", "sub-title", "Size"));
    }
    grove::Element: size = el("row", "xyz", "");
    size.append_child(float_input(f[3], "0.1", base + "sx"));
    size.append_child(float_input(f[4], "0.1", base + "sy"));
    size.append_child(float_input(f[5], "0.1", base + "sz"));
    card.append_child(size);
    card.append_child(el("div", "sub-title", "Offset"));
    grove::Element: offset = el("row", "xyz", "");
    offset.append_child(float_input(f[6], "0.1", base + "ox"));
    offset.append_child(float_input(f[7], "0.1", base + "oy"));
    offset.append_child(float_input(f[8], "0.1", base + "oz"));
    card.append_child(offset);
    if (has_mass) then {
        grove::Element: mass_row = number_row("body", base + "mass", "Mass (kg)", f[31], "0.000001", "1000000000", "0.1", "box");
        mass_row.append_child(lock_button("Lock", "Lock the mass: changing the size or density keeps it the same", locks.contains("m"), base + "lock_mass"));
        card.append_child(mass_row);
        grove::Element: density_row = number_row("body", base + "density", "Density (" + f[34] + ")", f[11], "0.000001", "100000", "0.1", "box");
        density_row.append_child(lock_button("Lock", "Lock the density: changing the mass resizes it instead", locks.contains("d"), base + "lock_density"));
        card.append_child(density_row);
    } else then {
        card.append_child(number_row("body", base + "density", "Density", f[11], "0.0001", "100000", "0.1", "box"));
    }
    card.append_child(number_row("body", base + "friction", "Friction", f[12], "0", "2", "0.01", "slider"));
    card.append_child(number_row("body", base + "bounce", "Bounce", f[13], "0", "1", "0.01", "slider"));
    if (f.size() > 24l) then {
        bool: solid = f[24].contains("cylinder");
        if (f[2] == "rounded-box" && solid) then {
            card.append_child(number_row("body", base + "rounding", "Rounding", f[18], "0", "0.5", "0.005", "slider"));
        }
        if (solid) then {
            card.append_child(number_row("body", base + "roll", "Rolling friction", f[19], "0", "1", "0.005", "slider"));
            card.append_child(number_row("body", base + "spin", "Spin friction", f[20], "0", "1", "0.005", "slider"));
            card.append_child(el("div", "sub-title", "Grip along local X, Y, Z"));
            card.append_child(number_row("body", base + "gx", "X", f[21], "0", "2", "0.01", "slider"));
            card.append_child(number_row("body", base + "gy", "Y", f[22], "0", "2", "0.01", "slider"));
            card.append_child(number_row("body", base + "gz", "Z", f[23], "0", "2", "0.01", "slider"));
        }
    }
    if (f.size() > 29l && f[2] == "sphere-section") then {
        grove::Element: quick = grove::create_element("input_select");
        auto: pairs = "|Quick shape...;hemisphere|Hemisphere;dome|Dome (shallow cap);bowl|Bowl (hollow, open top);shell|Hollow ball;wedge|Wedge (90 degrees);quarter|Half dome".split(";");
        for (long int: q = 0l; q < pairs.size(); q += 1l) {
            auto: kv = pairs[q].split("|");
            grove::Element: opt = el("option", "", kv[1]);
            opt.set_attribute("value", kv[0]);
            quick.append_child(opt);
        }
        quick.set_value_string("");
        quick.on("change", [base](grove::Event&: e) -> void {
            if (e.target().value_string().empty()) then {
                return;
            }
            set_component(base + "section", e.target().value_string());
            fill_components();
        });
        card.append_child(quick);
        card.append_child(number_row("body", base + "pmin", "From (0 = top)", f[25], "0", "180", "1", "slider"));
        card.append_child(number_row("body", base + "pmax", "To (90 = half, 180 = bottom)", f[26], "0", "180", "1", "slider"));
        card.append_child(number_row("body", base + "amin", "Around from", f[27], "0", "360", "1", "slider"));
        card.append_child(number_row("body", base + "amax", "Around to", f[28], "0", "360", "1", "slider"));
        card.append_child(number_row("body", base + "shell", "Wall thickness (0 = solid)", f[29], "0", "5", "0.01", "box"));
    }
    if (f.size() > 17l) then {
        card.append_child(mix_row("Friction mix", f[14], f[16], base + "friction_mix"));
        card.append_child(mix_row("Bounce mix", f[15], f[17], base + "bounce_mix"));
    }
    card.append_child(switch_row("Enabled", f[9] == "1", base + "enabled"));
    card.append_child(switch_row("Sensor (trigger)", f[10] == "1", base + "sensor"));
    return card;
} end function collider_card

function fill_mix_select(grove::Element&: pick, bool: with_default, const string&: project_label) -> void {
    auto: rows = call("combine_modes", "").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: c = rows[i].split("\t");
        if (c.size() < 3l) then {
            continue;
        }
        if (c[0] == "default" && !with_default) then {
            continue;
        }
        string: label = c[1];
        if (c[0] == "default") then {
            label = "Default (" + project_label + ")";
        }
        grove::Element: opt = el("option", "", label);
        opt.set_attribute("value", c[0]);
        pick.append_child(opt);
    }
} end function fill_mix_select

function mix_row(const string&: label, const string&: value, const string&: project_label, const string&: field) -> grove::Element {
    grove::Element: row = el("row", "kv", "");
    row.append_child(el("text", "k", label));
    grove::Element: pick = grove::create_element("input_select");
    pick.set_attribute("class", "v");
    fill_mix_select(pick, true, project_label);
    pick.set_value_string(value);
    pick.on("change", [field](grove::Event&: e) -> void {
        set_component(field, e.target().value_string());
    });
    row.append_child(pick);
    return row;
} end function mix_row

function fill_script_choices(const string&: current) -> void {
    grove::Element: pick = grove::get_by_id("ins-script");
    clear(pick);
    grove::Element: none = el("option", "", "No script");
    none.set_attribute("value", "");
    pick.append_child(none);
    auto: rows = call("scripts", "").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        if (rows[i].empty()) then {
            continue;
        }
        grove::Element: opt = el("option", "", rows[i]);
        opt.set_attribute("value", rows[i]);
        pick.append_child(opt);
    }
    pick.set_value_string(current);
} end function fill_script_choices

function fill_components() -> void {
    if (selected.empty()) then {
        return;
    }
    filling = true;
    auto: rows = call("components", selected).split("\n");
    string: script = "";
    bool: has_body = false;
    string: owner = "";
    grove::Element: flags = grove::get_by_id("flags");
    grove::Element: colliders = grove::get_by_id("colliders");
    grove::Element: nums = grove::get_by_id("body-nums");
    grove::Element: aflags = grove::get_by_id("aflags");
    string: group = "";
    clear(flags);
    clear(colliders);
    clear(nums);
    clear(aflags);
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        if (f[0] == "script") then {
            script = f[1];
        } else if (f[0] == "owner") then {
            owner = f[1];
        } else if (f[0] == "body" && f.size() >= 6l) then {
            has_body = true;
            grove::get_by_id("ins-body-type").set_value_string(f[1]);
            grove::get_by_id("ins-body-enabled").set_value_bool(f[2] == "1");
        } else if (f[0] == "flag" && f.size() >= 4l) then {
            flags.append_child(switch_row(f[2], f[3] == "1", "flag:" + f[1]));
        } else if (f[0] == "num" && f.size() >= 8l) then {
            nums.append_child(number_row("body", f[1], f[2], f[3], f[4], f[5], f[6], f[7]));
        } else if (f[0] == "pick" && f.size() >= 5l) then {
            nums.append_child(pick_row("body", f[1], f[2], f[3], f[4]));
        } else if (f[0] == "title" && f.size() >= 2l) then {
            nums.append_child(el("div", "flag-group", f[1]));
        } else if (f[0] == "vec3" && f.size() >= 7l) then {
            nums.append_child(vec_row(f[1], f[2], f[3], f[4], f[5], f[6]));
        } else if (f[0] == "check" && f.size() >= 4l) then {
            nums.append_child(switch_row(f[2], f[3] == "1", f[1]));
        } else if (f[0] == "aflag" && f.size() >= 5l) then {
            if (f[4] != group) then {
                group = f[4];
                aflags.append_child(el("text", "flag-group", group));
            }
            aflags.append_child(switch_row(f[2], f[3] == "1", "aflag:" + f[1]));
        } else if (f[0] == "collider" && f.size() >= 14l) then {
            colliders.append_child(collider_card(rows[i]));
        }
    }
    fill_script_choices(script);
    grove::get_by_id("ins-body").set_value_bool(has_body);
    show("body-box", has_body);
    show("ins-owner", !owner.empty());
    grove::get_by_id("ins-owner").set_inner_text("Its colliders belong to " + owner + "'s body");
    filling = false;
} end function fill_components

function select(const string&: id) -> void {
    selected = call("select", id);
    build_tree();
    fill_inspector();
    fill_details();
} end function select

function set_field(const string&: field) -> void {
    if (filling || selected.empty()) then {
        return;
    }
    string: v = grove::get_by_id(field).value_float().to_string();
    call("set_transform", selected + "\t" + field + "\t" + v);
    refresh();
} end function set_field

function set_component(const string&: field, const string&: value) -> void {
    if (filling || selected.empty()) then {
        return;
    }
    string: r = call("set_component", selected + "\t" + field + "\t" + value);
    if (failed(r)) then {
        say(reason(r), true);
        fill_components();
    } else if (field.contains(":mass") || field.contains(":density") || field.contains(":sx") || field.contains(":sy") || field.contains(":sz") || field.contains(":lock_")) then {
        fill_components();
    }
    refresh();
} end function set_component

function center_tab(const string&: which) -> void {
    center = which;
    bool: scene = which == "scene";
    show("scene-bar", scene);
    show("sculpt-bar", scene && grove::get_by_id("tool-sculpt").has_class("on"));
    show("viewport", scene);
    show("scene-hint", scene);
    show("script-view", which == "script");
    show("graph-view", which == "graph");
    grove::get_by_id("tab-scene").remove_class("on");
    grove::get_by_id("tab-script").remove_class("on");
    grove::get_by_id("tab-graph").remove_class("on");
    grove::get_by_id("tab-" + which).add_class("on");
    show("center-tabs", !script_path.empty() || !graph_path.empty());
    if (which == "graph") then {
        call("graph_show", graph_path);
    } else if (scene) then {
        call("graph_show", "");
    }
} end function center_tab

function script_language(const string&: path) -> string {
    if (path.ends_with(".cpp") || path.ends_with(".hpp") || path.ends_with(".cc") || path.ends_with(".h")) then {
        return "cpp";
    }
    if (path.ends_with(".c")) then {
        return "c";
    }
    if (path.ends_with(".cs")) then {
        return "csharp";
    }
    if (path.ends_with(".java")) then {
        return "java";
    }
    if (path.ends_with(".lua")) then {
        return "lua";
    }
    return "walnut";
} end function script_language

function open_script(const string&: path) -> void {
    if (!script_path.empty() && script_dirty && script_path != path) then {
        save_script();
    }
    script_path = path;
    grove::Element: ed = grove::get_by_id("script-editor");
    ed.set_attribute("language", script_language(path));
    filling = true;
    ed.set_value_string(call("read_text", path));
    filling = false;
    script_dirty = false;
    grove::get_by_id("script-name").set_inner_text(path);
    grove::get_by_id("script-state").set_inner_text("");
    grove::get_by_id("tab-script").set_inner_text(path);
    show("tab-script", true);
    show("tab-script-close", true);
    grove::get_by_id("editor-command").set_value_string(call("editor_command", ""));
    center_tab("script");
} end function open_script

function save_script() -> void {
    if (script_path.empty()) then {
        return;
    }
    string: r = call("write_text", script_path + "\t" + grove::get_by_id("script-editor").value_string());
    if (failed(r)) then {
        say(reason(r), true);
        return;
    }
    script_dirty = false;
    grove::get_by_id("script-state").set_inner_text("saved");
    say("Saved " + script_path, false);
} end function save_script

function open_graph(const string&: path) -> void {
    string: r = call("graph_open", path);
    if (failed(r)) then {
        say(reason(r), true);
        return;
    }
    graph_path = path;
    show("graph-edit", false);
    show("tab-graph", true);
    show("tab-graph-close", true);
    grove::get_by_id("tab-graph").set_attribute("title", path);
    center_tab("graph");
    graph_status();
    grove::get_by_id("graph-canvas").focus();
} end function open_graph

function close_graph() -> void {
    if (graph_path.empty()) then {
        return;
    }
    string: r = call("graph_close", graph_path);
    if (r == "dirty") then {
        say(graph_path + " has unsaved changes. Save it, or close it again to throw them away.", true);
        return;
    }
    graph_path = "";
    show("tab-graph", false);
    show("tab-graph-close", false);
    center_tab("scene");
} end function close_graph

function graph_status() -> void {
    if (graph_path.empty()) then {
        return;
    }
    auto: f = call("graph_status", "").split("\t");
    if (f.size() < 4l) then {
        return;
    }
    grove::Element: s = grove::get_by_id("graph-status");
    s.set_inner_text(f[1]);
    if (f[1].starts_with("Compiles")) then {
        s.remove_class("bad");
    } else then {
        s.add_class("bad");
    }
    string: label = "Graph: " + graph_path;
    if (f[0] == "1") then {
        label = label + " *";
    }
    grove::get_by_id("tab-graph").set_inner_text(label);
} end function graph_status

function graph_result(const string&: r) -> void {
    auto: f = r.split("\t");
    if (f.size() < 1l) then {
        return;
    }
    if (f[0] == "edit" && f.size() > 4l) then {
        grove::get_by_id("graph-edit-label").set_inner_text(f[2] + " (" + f[3] + ")");
        grove::get_by_id("graph-edit-value").set_value_string(f[4]);
        show("graph-edit", true);
        grove::get_by_id("graph-edit-value").focus();
        return;
    }
    if (f[0] == "error" && f.size() > 1l) then {
        say(f[1], true);
    }
    if (f[0] == "changed" || f[0] == "error") then {
        graph_status();
    }
} end function graph_result

function save_graph() -> void {
    if (graph_path.empty()) then {
        return;
    }
    string: r = call("graph_save", graph_path);
    if (failed(r)) then {
        say(reason(r), true);
    } else then {
        say("Saved " + graph_path, false);
    }
    graph_status();
} end function save_graph

function commit_graph_value(const string&: value) -> void {
    string: r = call("graph_set_value", value);
    if (failed(r)) then {
        say(reason(r), true);
    }
    show("graph-edit", false);
    graph_status();
    grove::get_by_id("graph-canvas").focus();
} end function commit_graph_value

function file_action(const string&: key) -> void {
    string: path = file_target;
    if (path.empty()) then {
        return;
    }
    if (key == "here") then {
        open_script(path);
    } else if (key == "external") then {
        string: r = call("open_external", path);
        if (failed(r)) then {
            say(reason(r), true);
        } else then {
            say("Opened " + path + " in your editor", false);
        }
    } else if (key == "graph") then {
        open_graph(path);
    } else if (key == "place") then {
        string: r = call("place_model", path);
        if (failed(r)) then {
            say(reason(r), true);
            return;
        }
        auto: f = r.split("\t");
        refresh();
        build_tree();
        if (f.size() > 1l) then {
            select(f[1]);
        }
        say("Placed " + path + ". Move it with G, turn it with R, resize it with T.", false);
    } else if (key == "system") then {
        string: r = call("open_system", path);
        if (failed(r)) then {
            say(reason(r), true);
        }
    } else if (key == "preview") then {
        open_file(path);
    }
} end function file_action

function open_file(const string&: path) -> void {
    grove::get_by_id("code-title").set_inner_text(path);
    grove::get_by_id("code").set_value_string(call("read_file", path));
    grove::navigate("code-page");
} end function open_file

function enter_editor() -> void {
    script_path = "";
    script_dirty = false;
    graph_path = "";
    show("tab-script", false);
    show("tab-script-close", false);
    show("tab-graph", false);
    show("tab-graph-close", false);
    center_tab("scene");
    refresh();
    apply_outliner_prefs();
    build_tree();
    fill_details();
    build_files();
    build_templates();
    update_template_bar();
    fill_inspector();
    grove::navigate("editor");
} end function enter_editor

function add_entity(const string&: parent) -> void {
    string: kind = grove::get_by_id("add-kind").value_string();
    string: id = call("add_entity", "Entity\t" + parent + "\t" + kind);
    refresh();
    select(id);
} end function add_entity

function save_project() -> void {
    string: r = call("save", "");
    if (failed(r)) then {
        say("Save failed: " + reason(r), true);
    } else then {
        say("Saved", false);
    }
    refresh();
} end function save_project

function poll_logs() -> void {
    auto: rows = call("logs", log_seq).split("\n");
    if (rows.size() < 1l) then {
        return;
    }
    log_seq = rows[0];
    for (long int: i = 1l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        say(f[1], f[0] == "!");
    }
} end function poll_logs

grove::get_by_id("create").on("click", [](grove::Event&: e) -> void {
    string: where = grove::get_by_id("new-where").value_string();
    string: name = grove::get_by_id("new-name").value_string();
    if (where.empty() || name.empty()) then {
        grove::get_by_id("welcome-error").set_inner_text("Pick a name and a location first.");
        show("welcome-error", true);
        return;
    }
    string: dim = grove::get_by_id("new-dim").value_string();
    string: r = call("new_project", where + "/" + name + "\t" + name + "\t" + dim);
    if (failed(r)) then {
        grove::get_by_id("welcome-error").set_inner_text(reason(r));
        show("welcome-error", true);
        return;
    }
    enter_editor();
    say("Made " + dim + " project " + name, false);
});

grove::get_by_id("open-folder").on("change", [](grove::Event&: e) -> void {
    string: r = call("open_project", e.target().value_string());
    if (failed(r)) then {
        grove::get_by_id("welcome-error").set_inner_text(reason(r));
        show("welcome-error", true);
        return;
    }
    enter_editor();
});

