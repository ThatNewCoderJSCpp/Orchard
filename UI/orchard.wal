import module.grove
import module.strings
import module.io

string: selected = "";
string: mode = "edit";
string: log_seq = "0";
bool: filling = false;
string: menu_target = "";
string: inspecting = "";
string: outline_side = "left";
string: outline_group = "sections";
bool: details_on = true;
bool: sculpt_down = false;
string: sculpt_id = "";
string: center = "scene";
string: script_path = "";
bool: script_dirty = false;
string: file_target = "";
string: graph_path = "";

