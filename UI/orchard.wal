grove::get_by_id("details-open").on("change", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    details_on = e.target().value_bool();
    string: v = "0";
    if (details_on) then {
        v = "1";
    }
    call("set_pref", "details.open\t" + v);
    fill_details();
});

grove::get_by_id("outline-options").on("click", [](grove::Event&: e) -> void {
    grove::get_by_id("outline-settings").toggle_class("hidden");
});

grove::get_by_id("outline-side").on("click", [](grove::Event&: e) -> void {
    string: side = "right";
    if (outline_side == "right") then {
        side = "left";
    }
    place_outliner(side);
    call("set_pref", "outliner.side\t" + side);
});

grove::get_by_id("render-mode").on("change", [](grove::Event&: e) -> void {
    if (filling) then {
        return;
    }
    string: v = e.target().value_string();
    if (v == "path" || v == "photon") then {
        call("set_pref", "viewport.trace\t" + v);
    } else then {
        call("set_pref", "viewport.quality\t" + v);
        call("set_pref", "viewport.trace\toff");
        v = "off";
    }
    show("trace-info", v != "off");
    grove::get_by_id("trace-info").set_inner_text("");
});

grove::get_by_id("details-edit").on("click", [](grove::Event&: e) -> void {
    open_inspect(selected, false);
});

grove::get_by_id("inspect-delete").on("click", [](grove::Event&: e) -> void {
    if (inspecting.empty()) then {
        return;
    }
    call("remove_entity", inspecting);
    inspecting = "";
    grove::get_by_id("inspect-dialog").close_modal();
    refresh();
    build_tree();
    fill_inspector();
    fill_details();
});

if (call("state", "").starts_with("1")) then {
    enter_editor();
}
