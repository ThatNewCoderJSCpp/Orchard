} end function explode

function explode_by(const Entity&: attacker, short float: x, short float: y, short float: z, short float: radius, short float: force, short float: damage) -> long int {
    return NativeWorld::explode_by(attacker.raw, x, y, z, radius, force, damage);
} end function explode_by

function push_away(short float: x, short float: y, short float: z, short float: radius, short float: force) -> long int {
