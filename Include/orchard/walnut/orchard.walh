extern "C++" from "<orchard/script/script_api.hpp>" {
    class NativeEntity as "orchard::script::Entity" {
    public:
        constructor();
        static function current() -> NativeEntity;
        static function none() -> NativeEntity;
        function exists() const -> bool;
        function same(const NativeEntity&: other) const -> bool;
        function name() const -> string;
        function set_name(const string&: name) const -> void;
        function parent() const -> NativeEntity;
        function destroy() const -> void;
        function get(long int: which, long int: axis) const -> short float;
        function set(long int: which, short float: x, short float: y, short float: z) const -> void;
        function push(long int: kind, short float: x, short float: y, short float: z) const -> void;
        function has_body() const -> bool;
        function touching(const NativeEntity&: other) const -> bool;
        function set_layers(long int: layer, long int: mask) const -> void;
    } end class NativeEntity

    class NativeWorld as "orchard::script::World" {
    public:
        static function on_start(function() -> void: fn) -> void;
        static function on_tick(function() -> void: fn) -> void;
        static function on_stop(function() -> void: fn) -> void;
        static function log(const string&: message) -> void;
        static function warn(const string&: message) -> void;
        static function dt() -> short float;
        static function time() -> short float;
        static function is_2d() -> bool;
        static function key_down(const string&: key) -> bool;
        static function find(const string&: name) -> NativeEntity;
        static function spawn(const string&: name) -> NativeEntity;
        static function spawn_child(const string&: name, const NativeEntity&: parent) -> NativeEntity;
        static function instantiate(const string&: entity_template, short float: x, short float: y, short float: z) -> NativeEntity;
        static function instantiate_child(const string&: entity_template, short float: x, short float: y, short float: z, const NativeEntity&: parent) -> NativeEntity;
        static function play_particles(const NativeEntity&: e) -> void;
        static function stop_particles(const NativeEntity&: e) -> void;
        static function burst_particles(const NativeEntity&: e, long int: count) -> void;
        static function clear_particles(const NativeEntity&: e) -> void;
        static function play_animation(const NativeEntity&: e, const string&: clip, short float: fade) -> void;
        static function play_animation_once(const NativeEntity&: e, const string&: clip, short float: fade) -> void;
        static function stop_animation(const NativeEntity&: e) -> void;
        static function resume_animation(const NativeEntity&: e) -> void;
        static function set_animation_speed(const NativeEntity&: e, short float: speed) -> void;
        static function animation_time(const NativeEntity&: e) -> short float;
        static function set_animation_time(const NativeEntity&: e, short float: seconds) -> void;
        static function animation_length(const NativeEntity&: e) -> short float;
        static function animation_playing(const NativeEntity&: e) -> bool;
        static function animation_event(const NativeEntity&: e) -> string;
        static function pour_fluid(short float: x, short float: y, short float: radius) -> long int;
        static function erase_fluid(short float: x, short float: y, short float: radius) -> long int;
        static function push_fluid(short float: x, short float: y, short float: radius, short float: vx, short float: vy) -> long int;
        static function splash_fluid(short float: x, short float: y, short float: radius, short float: strength) -> long int;
        static function paint_sand(short float: x, short float: y, short float: radius, long int: cell) -> long int;
        static function raycast(short float: ox, short float: oy, short float: oz, short float: dx, short float: dy, short float: dz, short float: max_distance) -> NativeEntity;
        static function hit(long int: which) -> short float;
        static function overlap_sphere(short float: x, short float: y, short float: z, short float: radius) -> long int;
        static function overlap_at(long int: index) -> NativeEntity;
        static function health(const NativeEntity&: e) -> short float;
        static function max_health(const NativeEntity&: e) -> short float;
        static function has_health(const NativeEntity&: e) -> bool;
        static function set_health(const NativeEntity&: e, short float: value) -> void;
        static function set_max_health(const NativeEntity&: e, short float: value) -> void;
        static function add_health(const NativeEntity&: e, short float: amount) -> short float;
        static function heal(const NativeEntity&: e, short float: amount) -> short float;
        static function damage(const NativeEntity&: e, short float: amount) -> short float;
        static function damage_from(const NativeEntity&: e, short float: amount, const NativeEntity&: attacker) -> short float;
        static function kill(const NativeEntity&: e) -> bool;
        static function is_dead(const NativeEntity&: e) -> bool;
        static function revive(const NativeEntity&: e) -> bool;
        static function revive_with(const NativeEntity&: e, short float: health) -> bool;
        static function set_invulnerable(const NativeEntity&: e, bool: on) -> void;
        static function damage_taken(const NativeEntity&: e) -> short float;
        static function died(const NativeEntity&: e) -> bool;
        static function last_attacker(const NativeEntity&: e) -> NativeEntity;
        static function ignite(const NativeEntity&: e, short float: seconds) -> void;
        static function extinguish(const NativeEntity&: e) -> void;
        static function is_burning(const NativeEntity&: e) -> bool;
        static function explode(short float: x, short float: y, short float: z, short float: radius, short float: force, short float: damage) -> long int;
        static function explode_by(const NativeEntity&: attacker, short float: x, short float: y, short float: z, short float: radius, short float: force, short float: damage) -> long int;
        static function push_away(short float: x, short float: y, short float: z, short float: radius, short float: force) -> long int;
        static function play_effect(const string&: effect, short float: x, short float: y, short float: z, short float: scale) -> NativeEntity;
        static function attach_effect(const string&: effect, const NativeEntity&: parent, short float: scale) -> NativeEntity;
        static function add_tag(const NativeEntity&: e, const string&: tag) -> void;
        static function remove_tag(const NativeEntity&: e, const string&: tag) -> void;
        static function has_tag(const NativeEntity&: e, const string&: tag) -> bool;
        static function tagged_count(const string&: tag) -> long int;
        static function tagged_at(const string&: tag, long int: i) -> NativeEntity;
        static function nearest_tagged(const string&: tag, const NativeEntity&: origin) -> NativeEntity;
        static function distance(const NativeEntity&: a, const NativeEntity&: b) -> short float;
        static function teleport(const NativeEntity&: e, short float: x, short float: y, short float: z) -> void;
        static function look_at(const NativeEntity&: e, short float: x, short float: y, short float: z) -> void;
        static function random(short float: low, short float: high) -> short float;
        static function random_int(long int: low, long int: high) -> long int;
        static function clamp(short float: v, short float: low, short float: high) -> short float;
        static function lerp(short float: a, short float: b, short float: t) -> short float;
        static function move_towards(short float: current, short float: target, short float: max_step) -> short float;
    } end class NativeWorld
} end extern

class Entity {
public:
    NativeEntity: raw;

    function exists() const -> bool {
        return raw.exists();
    } end function exists

    function is(const Entity&: other) const -> bool {
        return raw.same(other.raw);
    } end function is

    function name() const -> string {
        return raw.name();
    } end function name

    function set_name(const string&: name) -> void {
        raw.set_name(name);
    } end function set_name

    function parent() const -> Entity {
        Entity: p;
        p.raw = raw.parent();
        return p;
    } end function parent

    function destroy() -> void {
        raw.destroy();
    } end function destroy

    function x() const -> double {
        return static_cast<double>(raw.get(0l, 0l));
    } end function x

    function y() const -> double {
        return static_cast<double>(raw.get(0l, 1l));
    } end function y

    function z() const -> double {
        return static_cast<double>(raw.get(0l, 2l));
    } end function z

    function set_position(double: x, double: y, double: z) -> void {
        raw.set(0l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function set_position

    function set_x(double: value) -> void {
        set_position(value, y(), z());
    } end function set_x

    function set_y(double: value) -> void {
        set_position(x(), value, z());
    } end function set_y

    function set_z(double: value) -> void {
        set_position(x(), y(), value);
    } end function set_z

    function translate(double: dx, double: dy, double: dz) -> void {
        set_position(x() + dx, y() + dy, z() + dz);
    } end function translate

    function rotation_x() const -> double {
        return static_cast<double>(raw.get(1l, 0l));
    } end function rotation_x

    function rotation_y() const -> double {
        return static_cast<double>(raw.get(1l, 1l));
    } end function rotation_y

    function rotation_z() const -> double {
        return static_cast<double>(raw.get(1l, 2l));
    } end function rotation_z

    function set_rotation(double: x, double: y, double: z) -> void {
        raw.set(1l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function set_rotation

    function set_rotation_x(double: value) -> void {
        set_rotation(value, rotation_y(), rotation_z());
    } end function set_rotation_x

    function set_rotation_y(double: value) -> void {
        set_rotation(rotation_x(), value, rotation_z());
    } end function set_rotation_y

    function set_rotation_z(double: value) -> void {
        set_rotation(rotation_x(), rotation_y(), value);
    } end function set_rotation_z

    function rotate(double: dx, double: dy, double: dz) -> void {
        set_rotation(rotation_x() + dx, rotation_y() + dy, rotation_z() + dz);
    } end function rotate

    function scale_x() const -> double {
        return static_cast<double>(raw.get(2l, 0l));
    } end function scale_x

    function scale_y() const -> double {
        return static_cast<double>(raw.get(2l, 1l));
    } end function scale_y

    function scale_z() const -> double {
        return static_cast<double>(raw.get(2l, 2l));
    } end function scale_z

    function set_scale(double: x, double: y, double: z) -> void {
        raw.set(2l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function set_scale

    function set_scale_x(double: value) -> void {
        set_scale(value, scale_y(), scale_z());
    } end function set_scale_x

    function set_scale_y(double: value) -> void {
        set_scale(scale_x(), value, scale_z());
    } end function set_scale_y

    function set_scale_z(double: value) -> void {
        set_scale(scale_x(), scale_y(), value);
    } end function set_scale_z

    function velocity_x() const -> double {
        return static_cast<double>(raw.get(3l, 0l));
    } end function velocity_x

    function velocity_y() const -> double {
        return static_cast<double>(raw.get(3l, 1l));
    } end function velocity_y

    function velocity_z() const -> double {
        return static_cast<double>(raw.get(3l, 2l));
    } end function velocity_z

    function set_velocity(double: x, double: y, double: z) -> void {
        raw.set(3l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function set_velocity

    function set_velocity_x(double: value) -> void {
        set_velocity(value, velocity_y(), velocity_z());
    } end function set_velocity_x

    function set_velocity_y(double: value) -> void {
        set_velocity(velocity_x(), value, velocity_z());
    } end function set_velocity_y

    function set_velocity_z(double: value) -> void {
        set_velocity(velocity_x(), velocity_y(), value);
    } end function set_velocity_z

    function spin_x() const -> double {
        return static_cast<double>(raw.get(4l, 0l));
    } end function spin_x

    function spin_y() const -> double {
        return static_cast<double>(raw.get(4l, 1l));
    } end function spin_y

    function spin_z() const -> double {
        return static_cast<double>(raw.get(4l, 2l));
    } end function spin_z

    function set_spin(double: x, double: y, double: z) -> void {
        raw.set(4l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function set_spin

    function set_spin_x(double: value) -> void {
        set_spin(value, spin_y(), spin_z());
    } end function set_spin_x

    function set_spin_y(double: value) -> void {
        set_spin(spin_x(), value, spin_z());
    } end function set_spin_y

    function set_spin_z(double: value) -> void {
        set_spin(spin_x(), spin_y(), value);
    } end function set_spin_z

    function world_x() const -> double {
        return static_cast<double>(raw.get(5l, 0l));
    } end function world_x

    function world_y() const -> double {
        return static_cast<double>(raw.get(5l, 1l));
    } end function world_y

    function world_z() const -> double {
        return static_cast<double>(raw.get(5l, 2l));
    } end function world_z

    function push(double: x, double: y, double: z) -> void {
        raw.push(0l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function push

    function add_force(double: x, double: y, double: z) -> void {
        raw.push(1l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function add_force

    function add_torque(double: x, double: y, double: z) -> void {
        raw.push(2l, static_cast<short float>(x), static_cast<short float>(y), static_cast<short float>(z));
    } end function add_torque

    function has_body() const -> bool {
        return raw.has_body();
    } end function has_body

    function touching(const Entity&: other) const -> bool {
        return raw.touching(other.raw);
    } end function touching

    function set_layers(long int: layer, long int: mask) const -> void {
        raw.set_layers(layer, mask);
    } end function set_layers
} end class Entity

class RayHit {
public:
    Entity: entity;
    short float: x = 0.0;
    short float: y = 0.0;
    short float: z = 0.0;
    short float: nx = 0.0;
    short float: ny = 0.0;
    short float: nz = 0.0;
    short float: distance = 0.0;

    function hit() const -> bool {
        return entity.exists();
    } end function hit
} end class RayHit

function raycast(short float: ox, short float: oy, short float: oz, short float: dx, short float: dy, short float: dz, short float: max_distance) -> RayHit {
    RayHit: r;
    r.entity.raw = NativeWorld::raycast(ox, oy, oz, dx, dy, dz, max_distance);
    r.x = NativeWorld::hit(0l);
    r.y = NativeWorld::hit(1l);
    r.z = NativeWorld::hit(2l);
    r.nx = NativeWorld::hit(3l);
    r.ny = NativeWorld::hit(4l);
    r.nz = NativeWorld::hit(5l);
    r.distance = NativeWorld::hit(6l);
    return r;
} end function raycast

function overlap_count(short float: x, short float: y, short float: z, short float: radius) -> long int {
    return NativeWorld::overlap_sphere(x, y, z, radius);
} end function overlap_count

function overlap_at(long int: index) -> Entity {
    Entity: e;
    e.raw = NativeWorld::overlap_at(index);
    return e;
} end function overlap_at

function current() -> Entity {
    Entity: e;
    e.raw = NativeEntity::current();
    return e;
} end function current

function find(const string&: name) -> Entity {
    Entity: e;
    e.raw = NativeWorld::find(name);
    return e;
} end function find

function spawn(const string&: name) -> Entity {
    Entity: e;
    e.raw = NativeWorld::spawn(name);
    return e;
} end function spawn

function spawn_child(const string&: name, const Entity&: parent) -> Entity {
    Entity: e;
    e.raw = NativeWorld::spawn_child(name, parent.raw);
    return e;
} end function spawn_child

function instantiate(const string&: entity_template, short float: x, short float: y, short float: z) -> Entity {
    Entity: e;
    e.raw = NativeWorld::instantiate(entity_template, x, y, z);
    return e;
} end function instantiate

function instantiate_child(const string&: entity_template, short float: x, short float: y, short float: z, const Entity&: parent) -> Entity {
    Entity: e;
    e.raw = NativeWorld::instantiate_child(entity_template, x, y, z, parent.raw);
    return e;
} end function instantiate_child

function play_particles(const Entity&: e) -> void {
    NativeWorld::play_particles(e.raw);
} end function play_particles

function stop_particles(const Entity&: e) -> void {
    NativeWorld::stop_particles(e.raw);
} end function stop_particles

function burst_particles(const Entity&: e, long int: count) -> void {
    NativeWorld::burst_particles(e.raw, count);
} end function burst_particles

function clear_particles(const Entity&: e) -> void {
    NativeWorld::clear_particles(e.raw);
} end function clear_particles

function play_animation(const Entity&: e, const string&: clip) -> void {
    NativeWorld::play_animation(e.raw, clip, 0.25);
} end function play_animation

function play_animation_fade(const Entity&: e, const string&: clip, short float: fade) -> void {
    NativeWorld::play_animation(e.raw, clip, fade);
} end function play_animation_fade

function play_animation_once(const Entity&: e, const string&: clip) -> void {
    NativeWorld::play_animation_once(e.raw, clip, 0.25);
} end function play_animation_once

function stop_animation(const Entity&: e) -> void {
    NativeWorld::stop_animation(e.raw);
} end function stop_animation

function resume_animation(const Entity&: e) -> void {
    NativeWorld::resume_animation(e.raw);
} end function resume_animation

function set_animation_speed(const Entity&: e, short float: speed) -> void {
    NativeWorld::set_animation_speed(e.raw, speed);
} end function set_animation_speed

function animation_time(const Entity&: e) -> short float {
    return NativeWorld::animation_time(e.raw);
} end function animation_time

function set_animation_time(const Entity&: e, short float: seconds) -> void {
    NativeWorld::set_animation_time(e.raw, seconds);
} end function set_animation_time

function animation_length(const Entity&: e) -> short float {
    return NativeWorld::animation_length(e.raw);
} end function animation_length

function animation_playing(const Entity&: e) -> bool {
    return NativeWorld::animation_playing(e.raw);
} end function animation_playing

function animation_event(const Entity&: e) -> string {
    return NativeWorld::animation_event(e.raw);
} end function animation_event

function pour_fluid(short float: x, short float: y, short float: radius) -> long int {
    return NativeWorld::pour_fluid(x, y, radius);
} end function pour_fluid

function erase_fluid(short float: x, short float: y, short float: radius) -> long int {
    return NativeWorld::erase_fluid(x, y, radius);
} end function erase_fluid

function push_fluid(short float: x, short float: y, short float: radius, short float: vx, short float: vy) -> long int {
    return NativeWorld::push_fluid(x, y, radius, vx, vy);
} end function push_fluid

function splash_fluid(short float: x, short float: y, short float: radius, short float: strength) -> long int {
    return NativeWorld::splash_fluid(x, y, radius, strength);
} end function splash_fluid

function paint_sand(short float: x, short float: y, short float: radius, long int: cell) -> long int {
    return NativeWorld::paint_sand(x, y, radius, cell);
} end function paint_sand

function log(const string&: message) -> void {
    NativeWorld::log(message);
} end function log

function warn(const string&: message) -> void {
    NativeWorld::warn(message);
} end function warn

function dt() -> double {
    return static_cast<double>(NativeWorld::dt());
} end function dt

function time() -> double {
    return static_cast<double>(NativeWorld::time());
} end function time

function is_2d() -> bool {
    return NativeWorld::is_2d();
} end function is_2d

function key_down(const string&: key) -> bool {
    return NativeWorld::key_down(key);
} end function key_down

function on_start(function() -> void: fn) -> void {
    NativeWorld::on_start(fn);
} end function on_start

function on_tick(function() -> void: fn) -> void {
    NativeWorld::on_tick(fn);
} end function on_tick

function on_stop(function() -> void: fn) -> void {
    NativeWorld::on_stop(fn);
} end function on_stop

function health(const Entity&: e) -> short float {
    return NativeWorld::health(e.raw);
} end function health

function max_health(const Entity&: e) -> short float {
    return NativeWorld::max_health(e.raw);
} end function max_health

function has_health(const Entity&: e) -> bool {
    return NativeWorld::has_health(e.raw);
} end function has_health

function set_health(const Entity&: e, short float: value) -> void {
    NativeWorld::set_health(e.raw, value);
} end function set_health

function set_max_health(const Entity&: e, short float: value) -> void {
    NativeWorld::set_max_health(e.raw, value);
} end function set_max_health

