function distance(const Entity&: a, const Entity&: b) -> short float {
    return NativeWorld::distance(a.raw, b.raw);
} end function distance

function teleport(const Entity&: e, short float: x, short float: y, short float: z) -> void {
    NativeWorld::teleport(e.raw, x, y, z);
} end function teleport

function look_at(const Entity&: e, short float: x, short float: y, short float: z) -> void {
    NativeWorld::look_at(e.raw, x, y, z);
} end function look_at

function random(short float: low, short float: high) -> short float {
    return NativeWorld::random(low, high);
} end function random

function random_int(long int: low, long int: high) -> long int {
    return NativeWorld::random_int(low, high);
} end function random_int

function clamp(short float: v, short float: low, short float: high) -> short float {
    return NativeWorld::clamp(v, low, high);
} end function clamp

function lerp(short float: a, short float: b, short float: t) -> short float {
    return NativeWorld::lerp(a, b, t);
} end function lerp

function move_towards(short float: current, short float: target, short float: max_step) -> short float {
    return NativeWorld::move_towards(current, target, max_step);
} end function move_towards

export this
